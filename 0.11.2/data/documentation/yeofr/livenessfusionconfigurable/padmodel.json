{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/livenessfusionconfigurable\/padmodel"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"padModel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"YEOPADModel","kind":"typeIdentifier","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel","preciseIdentifier":"s:5YEOFR11YEOPADModelO"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Changing it changes the CROP as well as the weights: each model is","type":"text"},{"text":" ","type":"text"},{"text":"fed the context scale its own provenance calls for (2.7× or 4.0×),","type":"text"},{"text":" ","type":"text"},{"text":"and only ","type":"text"},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/base","isActive":true,"type":"reference"},{"text":" keeps the shipped edge-replicating fit","type":"text"},{"text":" ","type":"text"},{"text":"— the rest take the handoff’s own ","type":"text"},{"code":"_get_new_box","type":"codeVoice"},{"text":" clamp-and-shift. So","type":"text"},{"text":" ","type":"text"},{"text":"two models’ scores on one frame are not two readings of the same","type":"text"},{"text":" ","type":"text"},{"text":"input, and each is judged at its own live bar — the certified one for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/base","isActive":true,"type":"reference"},{"text":", the boundary its own training defines for the","type":"text"},{"text":" ","type":"text"},{"text":"rest. What IS identical is the machinery: one P(live) per frame, into","type":"text"},{"text":" ","type":"text"},{"text":"the same EMA and the same verdict state machine.","type":"text"}]}]}],"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"padModel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"YEOPADModel","preciseIdentifier":"s:5YEOFR11YEOPADModelO"}],"externalID":"s:5YEOFR26LivenessFusionConfigurableP8padModelAA11YEOPADModelOvp","role":"symbol","symbolKind":"property","title":"padModel","required":true,"modules":[{"name":"YEOFR"}],"roleHeading":"Instance Property"},"sections":[],"defaultImplementationsSections":[{"identifiers":["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/padModel-7bxug"],"title":"LivenessFusionConfigurable Implementations","anchor":"LivenessFusionConfigurable-Implementations"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/padModel"},"hierarchy":{"paths":[["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable"]]},"abstract":[{"text":"Which anti-spoof model the liveness signal runs. Defaults to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE32Veto","type":"reference"},{"text":" (","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionDefaults\/padModel","type":"reference"},{"text":").","type":"text"}],"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable":{"abstract":[{"type":"text","text":"The toggles the FR-trust pipeline reads to decide which signals — the"},{"type":"text","text":" "},{"type":"text","text":"liveness CNN, TrueDepth and face recognition — contribute to a frame’s"},{"type":"text","text":" "},{"type":"text","text":"trust verdict. Trust is unanimous across whichever are enabled; a"},{"type":"text","text":" "},{"type":"text","text":"disabled signal is neutral and cannot deny or admit on its own."}],"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable","kind":"symbol","title":"LivenessFusionConfigurable","type":"topic","url":"\/documentation\/yeofr\/livenessfusionconfigurable","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"LivenessFusionConfigurable","kind":"identifier"}],"navigatorTitle":[{"text":"LivenessFusionConfigurable","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel":{"role":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel","abstract":[{"text":"The anti-spoof model the liveness pipeline runs.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"YEOPADModel"}],"type":"topic","title":"YEOPADModel","url":"\/documentation\/yeofr\/yeopadmodel","kind":"symbol","navigatorTitle":[{"text":"YEOPADModel","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/quinceE25Veto":{"abstract":[{"type":"text","text":"Quince + E25 v2 veto — Android’s "},{"type":"codeVoice","code":"combined-qe25"},{"type":"text","text":" (YWLA-847). Two"},{"type":"text","text":" "},{"type":"text","text":"heads score every frame on the same face box, each on its own crops"},{"type":"text","text":" "},{"type":"text","text":"and under its own policy exactly as it runs alone (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"combinedHeads"},{"type":"text","text":"): "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quince"},{"type":"text","text":" (fp32) decides, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":" "},{"type":"text","text":"(E25 v2, equal fusion, its 1 s revoke hold and 0.1 s cadence gate)"},{"type":"text","text":" "},{"type":"text","text":"vetoes when it has decided spoof on a raw P(live) below"},{"type":"text","text":" "},{"type":"codeVoice","code":"PADVetoRule.vetoBar"},{"type":"text","text":" (0.35, chosen post hoc on office takes, not a"},{"type":"text","text":" "},{"type":"text","text":"pre-registered value). Evaluation only."}],"kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE25Veto","type":"topic","url":"\/documentation\/yeofr\/yeopadmodel\/quincee25veto","role":"symbol","title":"YEOPADModel.quinceE25Veto","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"quinceE25Veto"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"abstract":[{"type":"text","text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing."}],"url":"\/documentation\/yeofr","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","role":"collection","type":"topic","kind":"symbol","title":"YEOFR"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/quince":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"quince"}],"url":"\/documentation\/yeofr\/yeopadmodel\/quince","kind":"symbol","role":"symbol","title":"YEOPADModel.quince","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quince","abstract":[{"type":"text","text":"Quince — Coconut retrained with the live class weighted above the"},{"type":"text","text":" "},{"type":"text","text":"attack classes in the loss, to lift its genuine acceptance. Same"},{"type":"text","text":" "},{"type":"text","text":"EfficientNet-B2, 2.7× crop, 260×260 input, 7-class head and "},{"type":"codeVoice","code":"seq-8"},{"type":"text","text":" "},{"type":"text","text":"rule; only the weights differ. Delivered 2026-09-19; internal VAL"},{"type":"text","text":" "},{"type":"text","text":"only (balanced 95.9 %). Quince V1 ("},{"type":"codeVoice","code":"PADModelFile\/quinceV1"},{"type":"text","text":"):"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE32Veto","type":"reference","isActive":true},{"type":"text","text":" decides on V2 instead."}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/padModel":{"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/padmodel","abstract":[{"text":"Which anti-spoof model the liveness signal runs. Defaults to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE32Veto","type":"reference"},{"text":" (","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionDefaults\/padModel","type":"reference"},{"text":").","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"padModel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"YEOPADModel","kind":"typeIdentifier","preciseIdentifier":"s:5YEOFR11YEOPADModelO"}],"defaultImplementations":1,"title":"padModel","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/padModel","required":true},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/quinceE32Veto":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"quinceE32Veto"}],"url":"\/documentation\/yeofr\/yeopadmodel\/quincee32veto","kind":"symbol","role":"symbol","title":"YEOPADModel.quinceE32Veto","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE32Veto","abstract":[{"type":"text","text":"Quince + E32 veto — "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE25Veto","type":"reference","isActive":true},{"type":"text","text":" with "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPearE32","type":"reference","isActive":true},{"type":"text","text":" as the"},{"type":"text","text":" "},{"type":"text","text":"veto head, under the same rule and the same 0.35 bar (fitted with"},{"type":"text","text":" "},{"type":"text","text":"E25 v2, not re-fitted for E32). Android’s "},{"type":"codeVoice","code":"combined-qe32"},{"type":"text","text":" "},{"type":"text","text":"(feature\/YWLA-847-box-map-menu, 87f0e55), except that its decider is"},{"type":"text","text":" "},{"type":"text","text":"Quince V2 (ep98, 5-class, "},{"type":"codeVoice","code":"PADModelFile\/quince"},{"type":"text","text":") where "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quince","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"is V1, and its "},{"type":"codeVoice","code":"seq-8"},{"type":"text","text":" runs at rho 0.91 here"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"PADRollingMeanPolicy\/quince"},{"type":"text","text":") and still at 0.96 on Android. The"},{"type":"text","text":" "},{"type":"text","text":"default ("},{"type":"codeVoice","code":"LivenessFusionDefaults.padModel"},{"type":"text","text":")."}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/base":{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/base","abstract":[{"type":"text","text":"Shipped MiniFASNetV2 (2.7×) + MiniFASNetV1SE (4.0×), score-averaged."},{"type":"text","text":" "},{"type":"text","text":"3-class heads, live = index 1. The certified configuration."}],"title":"YEOPADModel.base","kind":"symbol","type":"topic","url":"\/documentation\/yeofr\/yeopadmodel\/base","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/padModel-7bxug":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"padModel","kind":"identifier"},{"text":": ","kind":"text"},{"text":"YEOPADModel","preciseIdentifier":"s:5YEOFR11YEOPADModelO","kind":"typeIdentifier"}],"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/padmodel-7bxug","kind":"symbol","role":"symbol","type":"topic","title":"padModel","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/padModel-7bxug","abstract":[]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionDefaults/padModel":{"url":"\/documentation\/yeofr\/livenessfusiondefaults\/padmodel","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionDefaults\/padModel","role":"symbol","abstract":[{"type":"text","text":"The shipped liveness model, Quince + E32 veto. Every other case is"},{"type":"text","text":" "},{"text":"an evaluation model.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"padModel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"YEOPADModel","preciseIdentifier":"s:5YEOFR11YEOPADModelO"}],"title":"padModel","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/papayaPearE32":{"abstract":[{"type":"text","text":"Papaya + Pear (E32) — "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":" with the Papaya half swapped for"},{"type":"text","text":" "},{"type":"text","text":"E32 (epoch 27): the same MiniFASNetV2 backbone deciding through a"},{"type":"text","text":" "},{"type":"text","text":"binary Live\/Spoof head (2 logits, live = index 0). Pear is the same"},{"type":"text","text":" "},{"type":"text","text":"E25B_v2 head "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":" bundles. Crops, input size, equal-weight"},{"type":"text","text":" "},{"type":"text","text":"fusion and the Candidate B rolling policy are "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":"‘s; only"},{"type":"text","text":" "},{"type":"text","text":"the Papaya weights differ. An evaluation entry beside "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"matching Android’s "},{"type":"codeVoice","code":"PapayaPearGeneration.E32"},{"type":"text","text":" (YWLA-847)."}],"kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPearE32","type":"topic","url":"\/documentation\/yeofr\/yeopadmodel\/papayapeare32","role":"symbol","title":"YEOPADModel.papayaPearE32","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"papayaPearE32"}]}}}