"},{"type":"text","text":" "},{"type":"text","text":"trust verdict. Trust is unanimous across whichever are enabled; a"},{"type":"text","text":" "},{"type":"text","text":"disabled signal is neutral and cannot deny or admit on its own."}],"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable","kind":"symbol","title":"LivenessFusionConfigurable","type":"topic","url":"\/documentation\/yeofr\/livenessfusionconfigurable","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"LivenessFusionConfigurable","kind":"identifier"}],"navigatorTitle":[{"text":"LivenessFusionConfigurable","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/cropScales":{"url":"\/documentation\/yeofr\/yeopadmodel\/cropscales","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/cropScales","role":"symbol","abstract":[{"type":"text","text":"How far each slot expands the face rect before the head sees it."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"cropScales"},{"kind":"text","text":": (narrow"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"kind":"text","text":", wide"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"kind":"text","text":")"}],"title":"cropScales","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/useFaceRecognition":{"defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/usefacerecognition","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/useFaceRecognition","required":true,"role":"symbol","abstract":[{"type":"text","text":"Whether the face-recognition identity gate participates. "},{"type":"codeVoice","code":"false"},{"type":"text","text":" "},{"type":"text","text":"makes it neutral — the same treatment the other two signals get when"},{"type":"text","text":" "},{"type":"text","text":"switched off — so trust rests on the remaining signals alone."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"useFaceRecognition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"useFaceRecognition","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/quinceE32Veto":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"quinceE32Veto"}],"url":"\/documentation\/yeofr\/yeopadmodel\/quincee32veto","kind":"symbol","role":"symbol","title":"YEOPADModel.quinceE32Veto","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE32Veto","abstract":[{"type":"text","text":"Quince + E32 veto — "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE25Veto","type":"reference","isActive":true},{"type":"text","text":" with "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPearE32","type":"reference","isActive":true},{"type":"text","text":" as the"},{"type":"text","text":" "},{"type":"text","text":"veto head, under the same rule and the same 0.35 bar (fitted with"},{"type":"text","text":" "},{"type":"text","text":"E25 v2, not re-fitted for E32). Android’s "},{"type":"codeVoice","code":"combined-qe32"},{"type":"text","text":" "},{"type":"text","text":"(feature\/YWLA-847-box-map-menu, 87f0e55), except that its decider is"},{"type":"text","text":" "},{"type":"text","text":"Quince V2 (ep98, 5-class, "},{"type":"codeVoice","code":"PADModelFile\/quince"},{"type":"text","text":") where "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quince","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"is V1, and its "},{"type":"codeVoice","code":"seq-8"},{"type":"text","text":" runs at rho 0.91 here"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"PADRollingMeanPolicy\/quince"},{"type":"text","text":") and still at 0.96 on Android. The"},{"type":"text","text":" "},{"type":"text","text":"default ("},{"type":"codeVoice","code":"LivenessFusionDefaults.padModel"},{"type":"text","text":")."}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/livenessRateHz":{"defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/livenessratehz","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/livenessRateHz","required":true,"role":"symbol","abstract":[{"type":"text","text":"The rate the LIVENESS signal runs at, when it should run slower than"},{"type":"text","text":" "},{"type":"text","text":"the pipeline. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" — the default — follows "},{"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"livenessRateHz"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"?"}],"title":"livenessRateHz","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/evidenceMinFaceLuma":{"defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/evidenceminfaceluma","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/evidenceMinFaceLuma","required":true,"role":"symbol","abstract":[{"type":"text","text":"Minimum face-crop BT.709 mean luminance (0–255) for a frame to"},{"type":"text","text":" "},{"type":"text","text":"count as latch evidence. Fitted on the 2026-06-05 walking trace:"},{"type":"text","text":" "},{"type":"text","text":"every deep genuine dip sat below ~85 while hits centred ~118."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"evidenceMinFaceLuma"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Float","preciseIdentifier":"s:Sf"}],"title":"evidenceMinFaceLuma","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/depthTrustFlatDropFrames":{"defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/depthtrustflatdropframes","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/depthTrustFlatDropFrames","required":true,"role":"symbol","abstract":[{"type":"text","text":"Consecutive raw-flat frames required to drop the trust gate’s"},{"type":"text","text":" "},{"type":"text","text":"confirmed-3D signal ("},{"type":"codeVoice","code":"depthTrustConfirmedThreeD"},{"type":"text","text":"). Asymmetric"},{"type":"text","text":" "},{"type":"text","text":"revoke-side stickiness for the depth signal "},{"type":"emphasis","inlineContent":[{"type":"text","text":"only"}]},{"type":"text","text":": the 3D-confirm"},{"type":"text","text":" "},{"type":"text","text":"path (5 consecutive 3D, no cold-start bypass) is untouched, so"},{"type":"text","text":" "},{"type":"text","text":"admission timing and the single-blip flash guard are unchanged —"},{"type":"text","text":" "},{"type":"text","text":"raising this only makes an already-confirmed 3D face ride out"},{"type":"text","text":" "},{"type":"text","text":"longer transient flat readings under changing light, instead of"},{"type":"text","text":" "},{"type":"text","text":"collapsing trust on a sensor blip (the depth signal AND-gates the"},{"type":"text","text":" "},{"type":"text","text":"whole fused verdict, so one flat blip drops trust even while the"},{"type":"text","text":" "},{"type":"text","text":"CNN and the recognition latch hold). The evaluator clamps this to"},{"type":"text","text":" "},{"type":"codeVoice","code":"[5, 15]"},{"type":"text","text":" — never below today’s 5, capped so a flat run still"},{"type":"text","text":" "},{"type":"text","text":"surfaces a real spoof \/ face-gone within a fraction of a second."},{"type":"text","text":" "},{"type":"text","text":"Default 5 preserves current behaviour exactly; raise it (e.g. 8 ≈"},{"type":"text","text":" "},{"type":"text","text":"400 ms at 20 fps) to smooth lighting-driven trust flicker."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"depthTrustFlatDropFrames"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"title":"depthTrustFlatDropFrames","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/adaptiveTemplateLearningEnabled":{"defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/adaptivetemplatelearningenabled","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/adaptiveTemplateLearningEnabled","required":true,"role":"symbol","abstract":[{"type":"text","text":"Whether a trusted, recognised frame may refresh the matched"},{"type":"text","text":" "},{"type":"text","text":"identity’s adaptive templates (Slot B) — biometric reference"},{"type":"text","text":" "},{"type":"text","text":"adaptation. "},{"type":"codeVoice","code":"false"},{"type":"text","text":" stops any new sample being learned; samples a"},{"type":"text","text":" "},{"type":"text","text":"gallery already holds (learned earlier, or carried in a loaded"},{"type":"text","text":" "},{"type":"text","text":"tracker) keep matching until the identity is re-enrolled. FIDO"},{"type":"text","text":" "},{"type":"text","text":"Biometrics Requirements §5.1.6 require adaptation to be off while a"},{"type":"text","text":" "},{"type":"text","text":"laboratory tests the system."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"adaptiveTemplateLearningEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"adaptiveTemplateLearningEnabled","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/latchEvidenceGateEnabled":{"defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/latchevidencegateenabled","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/latchEvidenceGateEnabled","required":true,"role":"symbol","abstract":[{"type":"text","text":"Opt-in continuity lever (default "},{"type":"codeVoice","code":"false"},{"type":"text","text":"): while the recognition"},{"type":"text","text":" "},{"type":"text","text":"latch is HELD, a frame whose face crop fails the evidence-quality"},{"type":"text","text":" "},{"type":"text","text":"check (dark \/ blurred — see "},{"type":"codeVoice","code":"FaceEvidenceQuality"},{"type":"text","text":") and carries no"},{"type":"text","text":" "},{"type":"text","text":"vendor-named identity casts no vote in the latch windows, so"},{"type":"text","text":" "},{"type":"text","text":"transient junk frames (AE hunting toward a backlit window, motion"},{"type":"text","text":" "},{"type":"text","text":"blur while walking) can’t fast-drop a genuine latch. NOT a"},{"type":"text","text":" "},{"type":"text","text":"floor change: enter gates are untouched (the gate is inert while"},{"type":"text","text":" "},{"type":"text","text":"unlatched), vendor-named frames always count, and after"},{"type":"text","text":" "},{"type":"codeVoice","code":"evidenceAbstentionCapFrames"},{"type":"text","text":" consecutive abstentions the frames"},{"type":"text","text":" "},{"type":"text","text":"count again — a covered or replaced face still drops trust."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"latchEvidenceGateEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"latchEvidenceGateEnabled","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"abstract":[{"type":"text","text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing."}],"url":"\/documentation\/yeofr","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","role":"collection","type":"topic","kind":"symbol","title":"YEOFR"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/padDecisionMode":{"defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/paddecisionmode","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/padDecisionMode","required":true,"role":"symbol","abstract":[{"type":"text","text":"How a stream of per-frame PAD scores becomes a verdict — continuous"},{"type":"text","text":" "},{"type":"text","text":"authentication, or one answer per attempt. A property of the FLOW"},{"type":"text","text":" "},{"type":"text","text":"the host runs rather than of the model; see "},{"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADDecisionMode","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"padDecisionMode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"YEOPADDecisionMode","preciseIdentifier":"s:5YEOFR18YEOPADDecisionModeO"}],"title":"padDecisionMode","ty