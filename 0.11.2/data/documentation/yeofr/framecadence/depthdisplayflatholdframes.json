{"sections":[],"abstract":[{"text":"How long the displayed depth chip holds “3D” across a flat run.","type":"text"},{"text":" ","type":"text"},{"text":"15 @ 10 Hz.","type":"text"}],"kind":"symbol","metadata":{"title":"depthDisplayFlatHoldFrames","symbolKind":"property","modules":[{"name":"YEOFR"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthDisplayFlatHoldFrames","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"role":"symbol","externalID":"s:5YEOFR12FrameCadenceV26depthDisplayFlatHoldFramesSivp","roleHeading":"Instance Property"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/framecadence\/depthdisplayflatholdframes"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthDisplayFlatHoldFrames"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FrameCadence"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthDisplayFlatHoldFrames","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The literal this replaces is 15 frames, and its comment described"},{"text":" ","type":"text"},{"type":"text","text":"that as “~0.75 s at 20 fps” — written before the pipeline moved to"},{"text":" ","type":"text"},{"type":"text","text":"10 Hz and never restated, so the shipped hold has in fact been"},{"type":"text","text":" "},{"text":"1.5 s. This derives the duration the code actually has today, not","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the one its comment claimed: correcting the number here would be a"},{"text":" ","type":"text"},{"type":"text","text":"silent behaviour change smuggled in as a refactor. If 0.75 s was the"},{"text":" ","type":"text"},{"text":"intent, that is a separate, deliberate retune with its own evidence.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FrameCadence":{"role":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FrameCadence","abstract":[{"text":"The frame rate the trust pipeline is running at, and the timing","type":"text"},{"text":" ","type":"text"},{"text":"constants derived from it.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FrameCadence","kind":"identifier"}],"type":"topic","title":"FrameCadence","url":"\/documentation\/yeofr\/framecadence","kind":"symbol","navigatorTitle":[{"text":"FrameCadence","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FrameCadence/depthDisplayFlatHoldFrames":{"url":"\/documentation\/yeofr\/framecadence\/depthdisplayflatholdframes","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthDisplayFlatHoldFrames","role":"symbol","abstract":[{"text":"How long the displayed depth chip holds “3D” across a flat run.","type":"text"},{"text":" ","type":"text"},{"text":"15 @ 10 Hz.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthDisplayFlatHoldFrames","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"depthDisplayFlatHoldFrames","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"