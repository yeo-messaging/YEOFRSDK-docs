{"sections":[],"abstract":[{"text":"One verdict per attempt: bank ","type":"text"},{"type":"codeVoice","code":"samples"},{"text":" fresh scores, average them,","type":"text"},{"text":" ","type":"text"},{"text":"decide once against the model’s own enter bar, and hold that answer","type":"text"},{"text":" ","type":"text"},{"text":"until the face state is reset. What a verification GATE needs — the","type":"text"},{"text":" ","type":"text"},{"text":"user sees “verifying”, then one accept or reject, and does not get a","type":"text"},{"text":" ","type":"text"},{"text":"different answer for looking at a different moment.","type":"text"}],"kind":"symbol","metadata":{"externalID":"s:5YEOFR18YEOPADDecisionModeO7oneShotyACSi_SftcACmF","roleHeading":"Case","role":"symbol","modules":[{"name":"YEOFR"}],"title":"YEOPADDecisionMode.oneShot(samples:bar:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oneShot","kind":"identifier"},{"text":"(","kind":"text"},{"text":"samples","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bar","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Float","preciseIdentifier":"s:Sf","kind":"typeIdentifier"},{"text":")","kind":"text"}],"symbolKind":"case"},"variants":[{"paths":["\/documentation\/yeofr\/yeopaddecisionmode\/oneshot(samples:bar:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADDecisionMode\/oneShot(samples:bar:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADDecisionMode"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oneShot","kind":"identifier"},{"text":"(","kind":"text"},{"text":"samples","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"bar"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Float","preciseIdentifier":"s:Sf"},{"kind":"text","text":")"}]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"It is also the shape offline whole-clip evaluation already scores, so","type":"text"},{"text":" ","type":"text"},{"text":"a lab number and a device number become the same kind of number. The","type":"text"},{"text":" ","type":"text"},{"text":"handoff’s aggregation table measures eight samples at the 0.70 bar:","type":"text"},{"text":" ","type":"text"},{"text":"known-attack false accept 9.2% against the rolling policy’s 11.7%,","type":"text"},{"text":" ","type":"text"},{"text":"paid for with ~0.7 s of evidence and 8.1% of Live sessions never","type":"text"},{"text":" ","type":"text"},{"text":"authenticated against 5.4%.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"samples","type":"codeVoice"},{"text":" is the count of SCORED frames, not of frames seen: a frame","type":"text"},{"text":" ","type":"text"},{"text":"with no confident face lengthens the attempt rather than deciding it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"bar","type":"codeVoice"},{"text":" is this mode’s OWN operating point, deliberately not the","type":"text"},{"text":" ","type":"text"},{"text":"continuous rule’s enter bar. Candidate B’s 0.70 was fitted for a","type":"text"},{"text":" ","type":"text"},{"text":"machine that can revoke — a bar is affordable when a wrong admit is","type":"text"},{"text":" ","type":"text"},{"text":"caught two updates later — and one shot has no revoke, so the same","type":"text"},{"text":" ","type":"text"},{"text":"number would be inherited from dynamics that no longer exist. The","type":"text"},{"text":" ","type":"text"},{"text":"economics also point the other way: here a wrong admit is final for","type":"text"},{"text":" ","type":"text"},{"text":"the attempt while a wrong reject only costs a retry, so this bar has","type":"text"},{"text":" ","type":"text"},{"text":"a case for being STRICTER than the continuous one, not looser.","type":"text"}]},{"inlineContent":[{"text":"Pick it off the handoff’s measured curve, never off a session you are","type":"text"},{"text":" ","type":"text"},{"text":"trying to make pass. At mean-5 that curve reads 0.70 → 11.7% known","type":"text"},{"text":" ","type":"text"},{"text":"attack accepted \/ 5.4% Live never authenticated, 0.75 → 7.5% \/ 8.1%;","type":"text"},{"text":" ","type":"text"},{"text":"mean-8 at 0.70 → 9.2% \/ 8.1%.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADDecisionMode/oneShot(samples:bar:)":{"abstract":[{"type":"text","text":"One verdict per attempt: bank "},{"code":"samples","type":"codeVoice"},{"type":"text","text":" fresh scores, average them,"},{"type":"text","text":" "},{"type":"text","text":"decide once against the model’s own enter bar, and hold that answer"},{"type":"text","text":" "},{"type":"text","text":"until the face state is reset. What a verification GATE needs — the"},{"type":"text","text":" "},{"type":"text","text":"user sees “verifying”, then one accept or reject, and does not get a"},{"type":"text","text":" "},{"type":"text","text":"different answer for looking at a different moment."}],"kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADDecisionMode\/oneShot(samples:bar:)","type":"topic","url":"\/documentation\/yeofr\/yeopaddecisionmode\/oneshot(samples:bar:)","role":"symbol","title":"YEOPADDecisionMode.oneShot(samples:bar:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"oneShot"},{"kind":"text","text":"("},{"kind":"externalParam","text":"samples"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bar"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":")"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADDecisionMode":{"url":"\/documentation\/yeofr\/yeopaddecisionmode","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADDecisionMode","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"YEOPADDecisionMode"}],"abstract":[{"type":"text","text":"How a stream of per-frame PAD scores becomes a verdict."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"YEOPADDecisionMode"}],"title":"YEOPADDecisionMode","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"abstract":[{"type":"text","text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing."}],"url":"\/documentation\/yeofr","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","role":"collection","type":"topic","kind":"symbol","title":"YEOFR"}}}