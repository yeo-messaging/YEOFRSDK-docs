{"metadata":{"roleHeading":"Type Property","externalID":"s:5YEOFR10PoseTargetO12yawThresholdSdvpZ","role":"symbol","symbolKind":"property","modules":[{"name":"YEOFR"}],"title":"yawThreshold","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"yawThreshold","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}]},"kind":"symbol","identifier":{"url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/yawThreshold","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"yawThreshold","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrowed in stages (±15° → ±10° → ±8° → ±7°): users reported having"},{"type":"text","text":" "},{"type":"text","text":"to “turn a lot” before a turn pose accepted. Vision’s yaw estimate"},{"type":"text","text":" "},{"type":"text","text":"compresses the physical rotation (the same effect documented for"},{"type":"text","text":" "},{"type":"text","text":"pitch below, milder on yaw), and at large physical turns Vision"},{"type":"text","text":" "},{"type":"text","text":"often drops yaw to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" — which disables the blind-Vision time"},{"type":"text","text":" "},{"type":"text","text":"fallback (a readable angle was seen earlier in the pose), so the"},{"type":"text","text":" "},{"type":"text","text":"pose can only clear via the ~10 s stall cap. Opening the matched"},{"type":"text","text":" "},{"type":"text","text":"window at ±7° lets the hold accumulate at a smaller, more reliably"},{"type":"text","text":" "},{"type":"text","text":"readable angle. Still clears the ±5° "},{"type":"codeVoice","code":"front"},{"type":"text","text":" zone with a 2° margin."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"±7° in radians — the yaw turn-pose gate ("},{"code":"yawLeft","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"yawRight","type":"codeVoice"},{"type":"text","text":")."}],"hierarchy":{"paths":[["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/posetarget\/yawthreshold"]}],"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/PoseTarget":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget","navigatorTitle":[{"kind":"identifier","text":"PoseTarget"}],"abstract":[{"type":"text","text":"Target head orientation for one slot of a gallery enrollment."}],"url":"\/documentation\/yeofr\/posetarget","title":"PoseTarget","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PoseTarget"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/PoseTarget/yawThreshold":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"yawThreshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"title":"yawThreshold","url":"\/documentation\/yeofr\/posetarget\/yawthreshold","role":"symbol","kind":"symbol","abstract":[{"text":"±7° in radians — the yaw turn-pose gate (","type":"text"},{"type":"codeVoice","code":"yawLeft"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"yawRight"},{"text":").","type":"text"}],"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/yawThreshold","type":"topic"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"role":"collection","url":"\/documentation\/yeofr","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","kind":"symbol","title":"YEOFR","type":"topic","abstract":[{"text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing.","type":"text"}]}}}