{"abstract":[{"text":"±7° in radians — the yaw turn-pose gate (","type":"text"},{"type":"codeVoice","code":"yawLeft"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"yawRight"},{"text":").","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/posetarget\/yawthreshold"]}],"metadata":{"roleHeading":"Type Property","externalID":"s:5YEOFR10PoseTargetO12yawThresholdSdvpZ","modules":[{"name":"YEOFR"}],"title":"yawThreshold","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"yawThreshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"role":"symbol","symbolKind":"property"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"yawThreshold","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Narrowed in stages (±15° → ±10° → ±8° → ±7°): users reported having"},{"type":"text","text":" "},{"type":"text","text":"to “turn a lot” before a turn pose accepted. Vision’s yaw estimate"},{"type":"text","text":" "},{"type":"text","text":"compresses the physical rotation (the same effect documented for"},{"type":"text","text":" "},{"type":"text","text":"pitch below, milder on yaw), and at large physical turns Vision"},{"type":"text","text":" "},{"type":"text","text":"often drops yaw to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" — which disables the blind-Vision time"},{"type":"text","text":" "},{"type":"text","text":"fallback (a readable angle was seen earlier in the pose), so the"},{"type":"text","text":" "},{"type":"text","text":"pose can only clear via the ~10 s stall cap. Opening the matched"},{"type":"text","text":" "},{"type":"text","text":"window at ±7° lets the hold accumulate at a smaller, more reliably"},{"type":"text","text":" "},{"type":"text","text":"readable angle. Still clears the ±5° "},{"type":"codeVoice","code":"front"},{"type":"text","text":" zone with a 2° margin."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/yawThreshold"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/PoseTarget":{"abstract":[{"type":"text","text":"Target head orientation for one slot of a gallery enrollment."}],"navigatorTitle":[{"kind":"identifier","text":"PoseTarget"}],"url":"\/documentation\/yeofr\/posetarget","title":"PoseTarget","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PoseTarget"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/PoseTarget/yawThreshold":{"fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"yawThreshold"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"±7° in radians — the yaw turn-pose gate ("},{"code":"yawLeft","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"yawRight"},{"text":").","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/yawThreshold","url":"\/documentation\/yeofr\/posetarget\/yawthreshold","type":"topic","title":"yawThreshold"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"abstract":[{"type":"text","text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing."}],"url":"\/documentation\/yeofr","title":"YEOFR","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR"}}}