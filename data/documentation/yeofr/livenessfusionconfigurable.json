e":"text"},{"type":"text","text":" "},{"type":"text","text":"failing frames count as misses again — the security backstop that"},{"type":"text","text":" "},{"type":"text","text":"keeps an endless dark stream from holding trust forever."}],"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/evidenceabstentioncapframes","title":"evidenceAbstentionCapFrames","required":true,"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"evidenceAbstentionCapFrames","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"defaultImplementations":1},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable":{"kind":"symbol","url":"\/documentation\/yeofr\/livenessfusionconfigurable","type":"topic","role":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LivenessFusionConfigurable"}],"abstract":[{"type":"text","text":"The toggles the FR-trust pipeline reads to decide which signals — the"},{"type":"text","text":" "},{"type":"text","text":"liveness CNN and TrueDepth — contribute to a frame’s trust verdict."}],"navigatorTitle":[{"kind":"identifier","text":"LivenessFusionConfigurable"}],"title":"LivenessFusionConfigurable"},"doc://com.youreyeonly.yeofr.YEOFR/s8SendableP":{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"}}}