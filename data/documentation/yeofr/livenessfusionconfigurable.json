ocumentation\/YEOFR\/LivenessFusionConfig","navigatorTitle":[{"text":"LivenessFusionConfig","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LivenessFusionConfig","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/s8SendableP","title":"Swift.Sendable"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/depthTrustFlatDropFrames":{"role":"symbol","defaultImplementations":1,"title":"depthTrustFlatDropFrames","required":true,"type":"topic","kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/depthTrustFlatDropFrames","url":"\/documentation\/yeofr\/livenessfusionconfigurable\/depthtrustflatdropframes","abstract":[{"type":"text","text":"Consecutive raw-flat frames required to drop the trust gate’s"},{"type":"text","text":" "},{"type":"text","text":"confirmed-3D signal ("},{"type":"codeVoice","code":"depthTrustConfirmedThreeD"},{"type":"text","text":"). Asymmetric"},{"type":"text","text":" "},{"type":"text","text":"revoke-side stickiness for the depth signal "},{"type":"emphasis","inlineContent":[{"type":"text","text":"only"}]},{"type":"text","text":": the 3D-confirm"},{"type":"text","text":" "},{"type":"text","text":"path (5 consecutive 3D, no cold-start bypass) is untouched, so"},{"type":"text","text":" "},{"type":"text","text":"admission timing and the single-blip flash guard are unchanged —"},{"type":"text","text":" "},{"type":"text","text":"raising this only makes an already-confirmed 3D face ride out"},{"type":"text","text":" "},{"type":"text","text":"longer transient flat readings under changing light, instead of"},{"type":"text","text":" "},{"type":"text","text":"collapsing trust on a sensor blip (the depth signal AND-gates the"},{"type":"text","text":" "},{"type":"text","text":"whole fused verdict, so one flat blip drops trust even while the"},{"type":"text","text":" "},{"type":"text","text":"CNN and the recognition latch hold). The evaluator clamps this to"},{"type":"text","text":" "},{"type":"codeVoice","code":"[5, 15]"},{"type":"text","text":" — never below today’s 5, capped so a flat run still"},{"type":"text","text":" "},{"type":"text","text":"surfaces a real spoof \/ face-gone within a fraction of a second."},{"type":"text","text":" "},{"type":"text","text":"Default 5 preserves current behaviour exactly; raise it (e.g. 8 ≈"},{"type":"text","text":" "},{"type":"text","text":"400 ms at 20 fps) to smooth lighting-driven trust flicker."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthTrustFlatDropFrames","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/useTrueDepthSDK":{"role":"symbol","title":"useTrueDepthSDK","required":true,"type":"topic","kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/useTrueDepthSDK","url":"\/documentation\/yeofr\/livenessfusionconfigurable\/usetruedepthsdk","abstract":[],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"useTrueDepthSDK","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/latchEvidenceGateEnabled":{"role":"symbol","defaultImplementations":1,"title":"latchEvidenceGateEnabled","required":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/latchEvidenceGateEnabled","kind":"symbol","abstract":[{"text":"Opt-in continuity lever (default ","type":"text"},{"code":"false","type":"codeVoice"},{"text":"): while the recognition","type":"text"},{"text":" ","type":"text"},{"text":"latch is HELD, a frame whose face crop fails the evidence-quality","type":"text"},{"text":" ","type":"text"},{"text":"check (dark \/ blurred — see ","type":"text"},{"code":"FaceEvidenceQuality","type":"codeVoice"},{"text":") and carries no","type":"text"},{"text":" ","type":"text"},{"text":"vendor-named identity casts no vote in the latch windows, so","type":"text"},{"text":" ","type":"text"},{"text":"transient junk frames (AE hunting toward a backlit window, motion","type":"text"},{"text":" ","type":"text"},{"text":"blur while walking) can’t fast-drop a genuine latch. NOT a","type":"text"},{"text":" ","type":"text"},{"text":"floor change: enter gates are untouched (the gate is inert while","type":"text"},{"text":" ","type":"text"},{"text":"unlatched), vendor-named frames always count, and after","type":"text"},{"text":" ","type":"text"},{"code":"evidenceAbstentionCapFrames","type":"codeVoice"},{"text":" consecutive abstentions the frames","type":"text"},{"text":" ","type":"text"},{"text":"count again — a covered or replaced face still drops trust.","type":"text"}],"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/latchevidencegateenabled","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"latchEvidenceGateEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://com.youreyeonly.yeofr.YEOFR/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"abstract":[{"type":"text","text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing."}],"url":"\/documentation\/yeofr","title":"YEOFR","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/evidenceAbstentionCapFrames":{"role":"symbol","defaultImplementations":1,"title":"evidenceAbstentionCapFrames","required":true,"type":"topic","kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/evidenceAbstentionCapFrames","url":"\/documentation\/yeofr\/livenessfusionconfigurable\/evidenceabstentioncapframes","abstract":[{"type":"text","text":"Hard cap on consecutive abstentions (~1.5 s at 20 fps). Past it,"},{"type":"text","text":" "},{"type":"text","text":"failing frames count as misses again — the security backstop that"},{"type":"text","text":" "},{"type":"text","text":"keeps an endless dark stream from holding trust forever."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"evidenceAbstentionCapFrames","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable":{"role":"symbol","title":"LivenessFusionConfigurable","url":"\/documentation\/yeofr\/livenessfusionconfigurable","kind":"symbol","abstract":[{"text":"The toggles the FR-trust pipeline reads to decide which signals — the","type":"text"},{"text":" ","type":"text"},{"text":"liveness CNN and TrueDepth — contribute to a frame’s trust verdict.","type":"text"}],"type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable","navigatorTitle":[{"text":"LivenessFusionConfigurable","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LivenessFusionConfigurable","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionDefaults":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"LivenessFusionDefaults","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"LivenessFusionDe