,"text":" "},{"kind":"identifier","text":"useLivenessSDK"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"type":"topic","required":true,"role":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/depthTrustFlatDropFrames":{"abstract":[{"text":"Consecutive raw-flat frames required to drop the trust gate’s","type":"text"},{"text":" ","type":"text"},{"text":"confirmed-3D signal (","type":"text"},{"code":"depthTrustConfirmedThreeD","type":"codeVoice"},{"text":"). Asymmetric","type":"text"},{"text":" ","type":"text"},{"text":"revoke-side stickiness for the depth signal ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"only","type":"text"}]},{"text":": the 3D-confirm","type":"text"},{"text":" ","type":"text"},{"text":"path (5 consecutive 3D, no cold-start bypass) is untouched, so","type":"text"},{"text":" ","type":"text"},{"text":"admission timing and the single-blip flash guard are unchanged —","type":"text"},{"text":" ","type":"text"},{"text":"raising this only makes an already-confirmed 3D face ride out","type":"text"},{"text":" ","type":"text"},{"text":"longer transient flat readings under changing light, instead of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"collapsing trust on a sensor blip (the depth signal AND-gates the"},{"type":"text","text":" "},{"type":"text","text":"whole fused verdict, so one flat blip drops trust even while the"},{"type":"text","text":" "},{"type":"text","text":"CNN and the recognition latch hold). The evaluator clamps this to"},{"type":"text","text":" "},{"type":"codeVoice","code":"[5, 15]"},{"type":"text","text":" — never below today’s 5, capped so a flat run still"},{"type":"text","text":" "},{"type":"text","text":"surfaces a real spoof \/ face-gone within a fraction of a second."},{"type":"text","text":" "},{"type":"text","text":"Default 5 preserves current behaviour exactly; raise it (e.g. 8 ≈"},{"type":"text","text":" "},{"type":"text","text":"400 ms at 20 fps) to smooth lighting-driven trust flicker."}],"title":"depthTrustFlatDropFrames","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/depthTrustFlatDropFrames","kind":"symbol","url":"\/documentation\/yeofr\/livenessfusionconfigurable\/depthtrustflatdropframes","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"depthTrustFlatDropFrames"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","required":true,"role":"symbol","defaultImplementations":1},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionDefaults":{"title":"LivenessFusionDefaults","abstract":[{"type":"text","text":"The shipped default values for every "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable"},{"type":"text","text":" "},{"type":"text","text":"toggle, used when a consumer does not override them."}],"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionDefaults","kind":"symbol","url":"\/documentation\/yeofr\/livenessfusiondefaults","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LivenessFusionDefaults"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LivenessFusionDefaults"}]},"doc://com.youreyeonly.yeofr.YEOFR/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/s16SendableMetatypeP"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/latchEvidenceGateEnabled":{"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"latchEvidenceGateEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentif