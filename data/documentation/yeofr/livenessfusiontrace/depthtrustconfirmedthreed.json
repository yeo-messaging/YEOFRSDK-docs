","text":" "},{"type":"text","text":"so a host has the gate’s own input available."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The DEBOUNCED confirmed-3D signal the trust gate actually consumes,","type":"text"},{"text":" ","type":"text"},{"text":"as distinct from the raw ","type":"text"},{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionTrace\/depthIsThreeD","isActive":true,"type":"reference"},{"text":" above.","type":"text"}],"variants":[{"paths":["\/documentation\/yeofr\/livenessfusiontrace\/depthtrustconfirmedthreed"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","references":{"doc://com.yeomessaging.YEOFR/documentation/YEOFR":{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","abstract":[{"text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing.","type":"text"}],"role":"collection","title":"YEOFR","type":"topic","kind":"symbol","url":"\/documentation\/yeofr"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionTrace/depthIsThreeD":{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionTrace\/depthIsThreeD","abstract":[],"role":"symbol","title":"depthIsThreeD","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthIsThreeD","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/yeofr\/livenessfusiontrace\/depthisthreed","kind":"symbol"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionTrace/depthTrustConfirmedThreeD":{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionTrace\/depthTrustConfirmedThreeD","abstract":[{"text":"The DEBOUNCED confirmed-3D signal the trust gate actually consumes,","type":"text"},{"text":" ","type":"text"},{"text":"as distinct from the raw ","type":"text"},{"isActive":true