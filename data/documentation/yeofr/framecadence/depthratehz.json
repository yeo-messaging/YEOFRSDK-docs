{"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"The rate DEPTH verdicts actually arrive at: always the ceiling."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Instance Property","role":"symbol","externalID":"s:5YEOFR12FrameCadenceV11depthRateHzSdvp","modules":[{"name":"YEOFR"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"depthRateHz"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"title":"depthRateHz","symbolKind":"property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"depthRateHz"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Depth does not run on the video clock and is not slowed by the host’s"},{"type":"text","text":" "},{"type":"text","text":"capture-rate control. "},{"type":"codeVoice","code":"handleDataOutputSynchronizer"},{"type":"text","text":" forwards the"},{"type":"text","text":" "},{"type":"text","text":"video half to the host’s admission gate and then runs the depth block"},{"type":"text","text":" "},{"type":"text","text":"REGARDLESS, throttled only by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthMinInterval"},{"type":"text","text":". So lowering the"},{"type":"text","text":" "},{"type":"text","text":"capture rate thins the video stream while depth keeps arriving at its"},{"type":"text","text":" "},{"type":"text","text":"own ceiling — depth always runs as fast as it can."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Assumes the capture device is at or above the ceiling, which both"},{"text":" ","type":"text"},{"text":"shipped cameras are (the SDK’s own locks 10 fps, CFRDemo’s 20). A","type":"text"},{"text":" ","type":"text"},{"text":"host running a slower camera would see depth follow that instead, and","type":"text"},{"text":" ","type":"text"},{"text":"this cannot observe it — ","type":"text"},{"type":"codeVoice","code":"FrameCadence"},{"text":" is handed a configured rate,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"not a device."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence"]]},"identifier":{"url":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthRateHz","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/framecadence\/depthratehz"]}],"references":{"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FrameCadence/depthRateHz":{"url":"\/documentation\/yeofr\/framecadence\/depthratehz","kind":"symbol","abstract":[{"text":"The rate DEPTH verdicts actually arrive at: always the ceiling.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"depthRateHz"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"title":"depthRateHz","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthRateHz","type":"topic"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FrameCadence/depthMinInterval":{"url":"\/documentation\/yeofr\/framecadence\/depthmininterval","kind":"symbol","abstract":[{"type":"text","text":"The interval the TrueDepth path throttles itself to, and therefore the"},{"type":"text","text":" "},{"type":"text","text":"shortest gap between two depth verdicts. Enforced in"},{"type":"text","text":" "},{"type":"codeVoice","code":"YEOFRTrueDepthHandling.handleDataOutputSynchronizer"},{"type":"text","text":", which reads this"},{"type":"text","text":" "},{"type":"text","text":"rather than a literal of its own so the two cannot drift."}],"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthMinInterval","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"}],"title":"depthMinInterval","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthMinInterval","type":"topic"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR":{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","abstract":[{"text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing.","type":"text"}],"role":"collection","title":"YEOFR","type":"topic","kind":"symbol","url":"\/documentation\/yeofr"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FrameCadence":{"url":"\/documentation\/yeofr\/framecadence","abstract":[{"text":"The frame rate the trust pipeline is running at, and the timing","type":"text"},{"text":" ","type":"text"},{"text":"constants derived from it.","type":"text"}],"title":"FrameCadence","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FrameCadence","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence","navigatorTitle":[{"text":"FrameCadence","kind":"identifier"}]}}}