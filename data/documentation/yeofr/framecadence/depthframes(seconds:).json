{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"depthFrames"},{"kind":"text","text":"("},{"kind":"externalParam","text":"seconds"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Separate from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/frames(seconds:)"},{"type":"text","text":" because the two count different"},{"type":"text","text":" "},{"type":"text","text":"things. A depth window counts verdicts arriving at "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthRateHz"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"deriving it from the video rate over-counts by exactly the ratio"},{"type":"text","text":" "},{"type":"text","text":"between them, so at 20 Hz video a 0.5 s window became 10 verdicts and"},{"type":"text","text":" "},{"type":"text","text":"took a full second to fire — on the one signal that AND-gates the"},{"type":"text","text":" "},{"type":"text","text":"whole fused trust decision."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"public"},{"type":"text","text":" because "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/depthTrustFlatDropFrames"},{"type":"text","text":" "},{"type":"text","text":"is a host-supplied count of exactly these verdicts. A host holding"},{"type":"text","text":" "},{"type":"text","text":"only "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/frames(seconds:)"},{"type":"text","text":" has no way to convert a duration correctly,"},{"type":"text","text":" "},{"type":"text","text":"and reaching for the video one is the same over-count one layer up."}]}]}],"abstract":[{"type":"text","text":"Frames spanning "},{"type":"codeVoice","code":"seconds"},{"type":"text","text":" of DEPTH verdicts."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/framecadence\/depthframes(seconds:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"depthFrames"},{"kind":"text","text":"("},{"kind":"externalParam","text":"seconds"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"roleHeading":"Instance Method","externalID":"s:5YEOFR12FrameCadenceV11depthFrames7secondsSiSd_tF","role":"symbol","title":"depthFrames(seconds:)","symbolKind":"method","modules":[{"name":"YEOFR"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthFrames(seconds:)"},"sections":[],"references":{"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FrameCadence/depthFrames(seconds:)":{"url":"\/documentation\/yeofr\/framecadence\/depthframes(seconds:)","kind":"symbol","abstract":[{"type":"text","text":"Frames spanning "},{"type":"codeVoice","code":"seconds"},{"type":"text","text":" of DEPTH verdicts."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"depthFrames"},{"kind":"text","text":"("},{"text":"seconds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"depthFrames(seconds:)","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthFrames(seconds:)","type":"topic"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/depthTrustFlatDropFrames":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Consecutive raw-flat frames required to drop the trust gate’s"},{"type":"text","text":" "},{"type":"text","text":"confirmed-3D signal ("},{"type":"codeVoice","code":"depthTrustConfirmedThreeD"},{"type":"text","text":"). Asymmetric"},{"type":"text","text":" "},{"type":"text","text":"revoke-side stickiness for the depth signal "},{"type":"emphasis","inlineContent":[{"type":"text","text":"only"}]},{"type":"text","text":": the 3D-confirm"},{"type":"text","text":" "},{"type":"text","text":"path (5 consecutive 3D, no cold-start bypass) is untouched, so"},{"type":"text","text":" "},{"type":"text","text":"admission timing and the single-blip flash guard are unchanged —"},{"type":"text","text":" "},{"type":"text","text":"raising this only makes an already-confirmed 3D face ride out"},{"type":"text","text":" "},{"type":"text","text":"longer transient flat readings under changing light, instead of"},{"type":"text","text":" "},{"type":"text","text":"collapsing trust on a sensor blip (the depth signal AND-gates the"},{"type":"text","text":" "},{"type":"text","text":"whole fused verdict, so one flat blip drops trust even while the"},{"type":"text","text":" "},{"type":"text","text":"CNN and the recognition latch hold). The evaluator clamps this to"},{"type":"text","text":" "},{"type":"codeVoice","code":"[5, 15]"},{"type":"text","text":" — never below today’s 5, capped so a flat run still"},{"type":"text","text":" "},{"type":"text","text":"surfaces a real spoof \/ face-gone within a fraction of a second."},{"type":"text","text":" "},{"type":"text","text":"Default 5 preserves current behaviour exactly; raise it (e.g. 8 ≈"},{"type":"text","text":" "},{"type":"text","text":"400 ms at 20 fps) to smooth lighting-driven trust flicker."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthTrustFlatDropFrames","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"required":true,"title":"depthTrustFlatDropFrames","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/depthTrustFlatDropFrames","defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/depthtrustflatdropframes"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR":{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","abstract":[{"text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing.","type":"text"}],"role":"collection","title":"YEOFR","type":"topic","kind":"symbol","url":"\/documentation\/yeofr"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FrameCadence":{"url":"\/documentation\/yeofr\/framecadence","abstract":[{"text":"The frame rate the trust pipeline is running at, and the timing","type":"text"},{"text":" ","type":"text"},{"text":"constants derived from it.","type":"text"}],"title":"FrameCadence","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FrameCadence","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence","navigatorTitle":[{"text":"FrameCadence","kind":"identifier"}]},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FrameCadence/seconds(frames:)":{"url":"\/documentation\/yeofr\/framecadence\/seconds(frames:)","kind":"symbol","abstract":[{"type":"text","text":"Seconds spanned by "},{"type":"codeVoice","code":"frames"},{"type":"text","text":" at this rate. The inverse of"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/frames(seconds:)"},{"type":"text","text":", for diagnostics and HUD text."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"seconds","kind":"identifier"},{"text":"(","kind":"text"},{"text":"frames","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"title":"seconds(frames:)","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/seconds(frames:)","type":"topic"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FrameCadence/frames(seconds:)":{"url":"\/documentation\/yeofr\/framecadence\/frames(seconds:)","kind":"symbol","abstract":[{"type":"text","text":"Frames spanning "},{"type":"codeVoice","code":"seconds"},{"type":"text","text":", never fewer than one — a window of zero"},{"type":"text","text":" "},{"type":"text","text":"frames would make its gate fire on every frame, inverting its meaning —"},{"type":"text","text":" "},{"type":"text","text":"and never more than "},{"type":"codeVoice","code":"Int.max"},{"type":"text","text":". "},{"type":"codeVoice","code":"Double(Int.max)"},{"type":"text","text":" is 2^63, so a count"},{"type":"text","text":" "},{"type":"text","text":"near "},{"type":"codeVoice","code":"Int.max"},{"type":"text","text":" sent through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/seconds(frames:)"},{"type":"text","text":" comes back as 2^63"},{"type":"text","text":" "},{"type":"text","text":"and saturates instead of trapping."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"frames"},{"kind":"text","text":"("},{"kind":"externalParam","text":"seconds"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"title":"frames(seconds:)","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/frames(seconds:)","type":"topic"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FrameCadence/depthRateHz":{"url":"\/documentation\/yeofr\/framecadence\/depthratehz","kind":"symbol","abstract":[{"text":"The rate DEPTH verdicts actually arrive at: always the ceiling.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"depthRateHz"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"title":"depthRateHz","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence\/depthRateHz","type":"topic"}}}