ext","text":"Why a frame is not evaluable. Carried on "},{"type":"codeVoice","code":"SpoofVerdict.invalid"},{"type":"text","text":" so"},{"type":"text","text":" "},{"type":"text","text":"consumers can render distinct UX for “no face”, “too close”, etc.,"},{"type":"text","text":" "},{"type":"text","text":"instead of treating every non-evaluable frame as a spoof."}],"role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InvalidFrameReason","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/InvalidFrameReason","navigatorTitle":[{"text":"InvalidFrameReason","kind":"identifier"}]},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustSession/verify(window:faceWidthEnvelope:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"verify","kind":"identifier"},{"text":"(","kind":"text"},{"text":"window","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"faceWidthEnvelope","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SN","text":"ClosedRange","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14CoreFoundation7CGFloatV","text":"CGFloat","kind":"typeIdentifier"},{"text":">?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:5YEOFR18VerificationRecordV","text":"VerificationRecord","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"One verification transaction — the certified decision."}],"url":"\/documentation\/yeofr\/facetrustsession\/verify(window:facewidthenvelope:)","type":"topic","kind":"symbol","title":"verify(window:faceWidthEnvelope:)","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/verify(window:faceWidthEnvelope:)","role":"symbol"},"doc://com.yeomessagi