ing.YEOFR\/documentation\/YEOFR\/YEOFRDepthVerdictDetail\/isCarriedOver","type":"topic"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/VerificationRejection/notGradable":{"url":"\/documentation\/yeofr\/verificationrejection\/notgradable","kind":"symbol","abstract":[{"type":"text","text":"The transaction produced no decision: the presentation-attack check"},{"type":"text","text":" "},{"type":"text","text":"ran, but the window held neither a genuine second nor a denial (the"},{"type":"text","text":" "},{"type":"text","text":"liveness CNN with no decided verdict, see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceEvaluationResult\/livenessWarmingUp"},{"type":"text","text":"; the face out of frame for"},{"type":"text","text":" "},{"type":"text","text":"the face-width envelope; a slide out of the depth window), or the"},{"type":"text","text":" "},{"type":"text","text":"transaction was cancelled before its"},{"type":"text","text":" "},{"type":"text","text":"window ended. A host records and shows it as no decision: it neither"},{"type":"text","text":" "},{"type":"text","text":"refuses nor accepts the face."}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notGradable","kind":"identifier"}],"title":"VerificationRejection.notGradable","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/VerificationRejection\/notGradable","type":"topic"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/VerificationOutcome/accept(similarity:)":{"url":"\/documentation\/yeofr\/verificationoutcome\/accept(similarity:)","title":"VerificationOutcome.accept(similarity:)","abstract":[{"type":"text","text":"The presentation held genuine and recognition matched the enrolled"},{"type":"text","text":" "},{"type":"text","text":"reference in the window. "},{"type":"codeVoice","code":"similarity"},{"type":"text","text":" is the best"},{"type":"text","text":" "},{"type":"text","text":"comparison score in the window."}],"role":"symbol","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accept","kind":"identifier"},{"text":"(","kind":"text"},{"text":"similarity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Float","preciseIdentifier":"s:Sf","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/VerificationOutcome\/accept(similarity:)"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/VerificationOutcome/window":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"window","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"How long one transaction observes the face: the one held second the"},{"type":"text","text":" "},{"type":"text","text":"presentation grade needs, plus 0.2 s of slack for the first frame."}],"url":"\/documentation\/yeofr\/verificationoutcome\/window","type":"topic","kind":"symbol","title":"window","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/VerificationOutcome\/window","role":"symbol"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/VerificationOutcome/Equatable-Implementations":{"url":"\/documentation\/yeofr\/verificationoutcome\/equatable-implementations","abstract":[],"title":"Equatable Implementations","role":"collectionGroup","type":"topic","kind":"article","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/VerificationOutcome\/Equatable-Implementations"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/TrustDecisionPath":{"url":"\/documentation\/yeofr\/trustdecisionpath","title":"TrustDecisionPath","abstract":[{"type":"text","text":"Which rule admitted (or denied) trust for a frame, so a log reviewer"},