:"text","text":"the held genuine second; the match is only as bound as the caller"},{"type":"text","text":" "},{"type":"text","text":"binds it. The live transaction"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/verify(window:faceWidthEnvelope:)","type":"reference","isActive":true},{"type":"text","text":") binds it to"},{"type":"text","text":" "},{"type":"text","text":"its window; a whole-clip grader binds it to the clip."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"decide"},{"kind":"text","text":"("},{"kind":"externalParam","text":"faceSeen"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"padVerdict"},{"kind":"text","text":": "},{"text":"PADVerdict","kind":"typeIdentifier","preciseIdentifier":"s:5YEOFR10PADVerdictO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"denial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:5YEOFR9PADDenialV","text":"PADDenial"},{"kind":"text","text":", "},{"kind":"externalParam","text":"matched"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"similarity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5YEOFR19VerificationOutcomeO","text":"VerificationOutcome"}],"title":"decide(faceSeen:padVerdict:denial:matched:similarity:)","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/VerificationOutcome\/decide(faceSeen:padVerdict:denial:matched:similarity:)","role":"symbol"},"doc://com.youreye