text"},{"text":" ","type":"text"},{"text":"confirmed flat run stood at any point in the window (the reading depth","type":"text"},{"type":"text","text":" "},{"type":"text","text":"denies on, so one confirmed before the press counts while it stands),"},{"type":"text","text":" "},{"type":"text","text":"else "},{"type":"codeVoice","code":"threeD"},{"type":"text","text":" if 3D was confirmed on readings taken in the window, else"},{"type":"text","text":" "},{"type":"codeVoice","code":"notDetermined"},{"type":"text","text":". 3D confirmed before the press is the face that was"},{"type":"text","text":" "},{"type":"text","text":"there then, and a detector’s repeat of an earlier frame’s verdict is"},{"type":"text","text":" "},{"type":"text","text":"not a reading ("},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOFRDepthVerdictDetail\/isCarriedOver","type":"reference","isActive":true},{"type":"text","text":")."}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/VerificationOutcome/noFace":{"url":"\/documentation\/yeofr\/verificationoutcome\/noface","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/VerificationOutcome\/noFace","role":"symbol","abstract":[{"type":"text","text":"No face was acquired during the window — a failure to acquire, not"},{"type":"text","text":" "},{"type":"text","text":"a refusal of anyone."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"noFace","kind":"identifier"}],"title":"VerificationOutcome.noFace","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOFaceLivenessDetectorResult":{"url":"\/documentation\/yeofr\/yeofacelivenessdetectorresult","abstract":[{"type":"text","text":"The outcome of a TrueDepth liveness check: "},{"code":".live","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":".spoof"},{"text":" (with a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","i