{"sections":[],"abstract":[{"text":"The rate FACE RECOGNITION runs at, when it should run slower than the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" — the default — follows ","type":"text"},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz","isActive":true,"type":"reference"},{"text":".","type":"text"}],"kind":"symbol","metadata":{"externalID":"s:5YEOFR26LivenessFusionConfigurableP17recognitionRateHzSdSgvp","roleHeading":"Instance Property","role":"symbol","required":true,"title":"recognitionRateHz","modules":[{"name":"YEOFR"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"recognitionRateHz","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"symbolKind":"property"},"defaultImplementationsSections":[{"title":"LivenessFusionConfigurable Implementations","anchor":"LivenessFusionConfigurable-Implementations","identifiers":["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/recognitionRateHz-6v8xb"]}],"variants":[{"paths":["\/documentation\/yeofr\/livenessfusionconfigurable\/recognitionratehz"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/recognitionRateHz","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"recognitionRateHz","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"This sub-rates the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"grading","type":"text"}]},{"text":" half of the FR call only: align, embed","type":"text"},{"text":" ","type":"text"},{"text":"and match. Vision detection still runs on every frame, because its","type":"text"},{"text":" ","type":"text"},{"text":"rects feed the framing gate, the preview overlay, the PAD crop, the","type":"text"},{"text":" ","type":"text"},{"text":"face-exposure metering and the face-loss debounce — a face that","type":"text"},{"text":" ","type":"text"},{"text":"leaves must still be noticed at full pipeline rate.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/livenessRateHz"},{"text":", gating and retuning are one change: a","type":"text"},{"text":" ","type":"text"},{"text":"frame that casts no similarity vote abstains from the latch windows","type":"text"},{"text":" ","type":"text"},{"text":"entirely, and those windows are re-derived from this rate so their","type":"text"},{"text":" ","type":"text"},{"text":"wall-clock spans hold. Sizing them off ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz"},{"text":" while feeding","type":"text"},{"text":" ","type":"text"},{"text":"them at a slower rate would stretch the sustain window — a departed","type":"text"},{"text":" ","type":"text"},{"text":"user would keep trust longer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Only ever slower. A value above ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz"},{"text":" is clamped.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"abstract":[{"type":"text","text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing."}],"url":"\/documentation\/yeofr","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","role":"collection","type":"topic","kind":"symbol","title":"YEOFR"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/livenessRateHz":{"defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/livenessratehz","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/livenessRateHz","required":true,"role":"symbol","abstract":[{"type":"text","text":"The rate the LIVENESS signal runs at, when it should run slower than"},{"type":"text","text":" "},{"type":"text","text":"the pipeline. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" — the default — follows "},{"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"livenessRateHz"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"?"}],"title":"livenessRateHz","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable":{"abstract":[{"type":"text","text":"The toggles the FR-trust pipeline reads to decide which signals — the"},{"type":"text","text":" "},{"type":"text","text":"liveness CNN, TrueDepth and face recognition — contribute to a frame’s"},{"type":"text","text":" "},{"type":"text","text":"trust verdict. Trust is unanimous across whichever are enabled; a"},{"type":"text","text":" "},{"type":"text","text":"disabled signal is neutral and cannot deny or admit on its own."}],"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable","kind":"symbol","title":"LivenessFusionConfigurable","type":"topic","url":"\/documentation\/yeofr\/livenessfusionconfigurable","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"LivenessFusionConfigurable","kind":"identifier"}],"navigatorTitle":[{"text":"LivenessFusionConfigurable","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FrameCadence":{"role":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FrameCadence","abstract":[{"text":"The frame rate the trust pipeline is running at, and the timing","type":"text"},{"text":" ","type":"text"},{"text":"constants derived from it.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FrameCadence","kind":"identifier"}],"type":"topic","title":"FrameCadence","url":"\/documentation\/yeofr\/framecadence","kind":"symbol","navigatorTitle":[{"text":"FrameCadence","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/frameRateHz":{"abstract":[{"text":"The rate, in frames per second, at which the host feeds the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline. Every frame-count-tuned constant in the trust pipeline is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"derived from this (see "},{"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FrameCadence","isActive":true},{"type":"text","text":"), so a host that changes its"},{"type":"text","text":" "},{"type":"text","text":"cadence keeps the same wall-clo