n walk, which includes the"},{"type":"text","text":" "},{"type":"text","text":"engine this build ships)."}]}]}],"identifier":{"url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOFRSDK\/beginEnrollmentVerification(identity:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Phase 2 of the two-phase enrolment contract: arm the verification"},{"type":"text","text":" "},{"type":"text","text":"walk for a just-enrolled (in-memory, not yet persisted) identity."},{"type":"text","text":" "},{"type":"text","text":"Subsequent single-face, valid-framing recognition frames are"},{"type":"text","text":" "},{"type":"text","text":"scored against its gallery; "},{"type":"codeVoice","code":"enrollmentVerificationStatus"},{"type":"text","text":" reports"},{"type":"text","text":" "},{"type":"text","text":"live progress and, at "},{"type":"codeVoice","code":"finishEnrollmentVerification()"},{"type":"text","text":" (or the"},{"type":"text","text":" "},{"type":"text","text":"~60 s budget), the walk’s FRR evidence —"},{"type":"text","text":" "},{"type":"codeVoice","code":"recognizedFrames \/ framesVerified"},{"type":"text","text":" is the enrolment’s measured"},{"type":"text","text":" "},{"type":"text","text":"live recognition rate, "},{"type":"codeVoice","code":"centroidHitCounts"},{"type":"text","text":" shows which centroids"},{"type":"text","text":" "},{"type":"text","text":"carried it."}],"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOFRSDK":{"title":"YEOFRSDK","abstract":[{"type":"text","text":"YEOFR main entry point."}],"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOFRSDK","kind":"symbol","url":"\/documentation\/yeofr\/yeofrsdk","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"YEOFRSDK"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"YEOFRSDK"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOFRSDK/begi