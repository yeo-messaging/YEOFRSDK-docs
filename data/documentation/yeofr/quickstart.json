dentifier","text":"PoseTarget","preciseIdentifier":"s:5YEOFR10PoseTargetO"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"EnrollmentProgress","preciseIdentifier":"s:5YEOFR18EnrollmentProgressV"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"Enrol "},{"code":"name","type":"codeVoice"},{"text":" from the live camera and return a stream of capture","type":"text"},{"text":" ","type":"text"},{"text":"progress. The existing frame loop drives the gallery walk; on completion","type":"text"},{"text":" ","type":"text"},{"text":"the service persists the gallery, refreshes ","type":"text"},{"type":"codeVoice","code":"enrolledName"},{"text":", resets the","type":"text"},{"text":" ","type":"text"},{"text":"trust pipeline against the fresh gallery, and re-arms the identity gate —","type":"text"},{"text":" ","type":"text"},{"text":"the consumer does none of that.","type":"text"}],"type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustService\/enroll(name:poses:)"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/EnrollmentProgress":{"url":"\/documentation\/yeofr\/enrollmentprogress","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EnrollmentProgress"}],"kind":"symbol","title":"EnrollmentProgress","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnrollmentProgress"}],"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/EnrollmentProgress","type":"topic","abstract":[{"text":"Progress for an in-flight enrolment capture. Yielded by","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustService\/enroll(name:poses:)"},{"type":"text","text":" and the stream finishes once the"},{"text":" ","type":"text"},{"text":"gallery is banked (or the capture can’t start).","type":"text"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustUpdate":{"abstract":[{"text":"One per-frame trust readout, with the framing gate already applied — so the","type":"text"},{"text":" ","type":"text"},{"text":"consumer renders a state, not a fusion of raw signals. Yielded by","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustService\/updates()","type":"reference","isActive":true},{"text":".","type":"text"}],"title":"FaceTrustUpdate","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"FaceTrustUpdate"}],"url":"\/documentation\/yeofr\/facetrustupdate","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustUpdate","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FaceTrustUpdate"}]}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"op":"replace","path":"\/identifier\/interfaceLanguage","value":"occ"},{"op":"add","path":"\/topicSections","value":null},{"op":"replace","path":"\/seeAlsoSections","value":[{"identifiers":[],"generated":true,"anchor":"Getting-started","title":"Getting started"}]}]}]}