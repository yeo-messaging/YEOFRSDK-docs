.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/frontThreshold","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/lightingAwareGallerySequence","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/offAxisThreshold","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/pitchThreshold","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/singleFront","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/yawThreshold"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/Equatable-Implementations","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/RawRepresentable-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PoseTarget"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Used by the gallery walk to gate per-pose capture on the","type":"text"},{"text":" ","type":"text"},{"text":"user’s actual head orientation (Vision’s ","type":"text"},{"code":"VNFaceObservation.yaw","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":".pitch","type":"codeVoice"},{"text":"). Without this gate the SDK would auto-advance within ~50 ms","type":"text"},{"text":" ","type":"text"},{"text":"of pose acceptance — the user has no time to physically change","type":"text"},{"text":" ","type":"text"},{"text":"orientation, so every captured appearance reflects the same head","type":"text"},{"text":" ","type":"text"},{"text":"pose and the gallery gains no angular breadth.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Thresholds were picked to match the user’s normal head-turn range"},{"type":"text","text":" "},{"type":"text","text":"during walking: a low ±7° on the yaw turn poses (Vision compresses"},{"type":"text","text":" "},{"type":"text","text":"physical head rotation, so a larger gate forces an exaggerated turn —"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"codeVoice","code":"yawThreshold"},{"type":"text","text":"), and a tight ±5° on "},{"type":"codeVoice","code":".front"},{"type":"text","text":" so it only matches"},{"type":"text","text":" "},{"type":"text","text":"when the user is genuinely centred while still leaving a 2° dead-band"},{"type":"text","text":" "},{"type":"text","text":"below the yaw gate. Vision reports yaw\/pitch in radians (≈ 0.26 rad"},{"type":"text","text":" "},{"type":"text","text":"per 15°)."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Vision sign conventions"}],"type":"strong"},{"text":" on the rotated, mirrored front-camera","type":"text"},{"text":" ","type":"text"},{"text":"portrait buffer (","type":"text"},{"code":"VNFaceObservation","type":"codeVoice"},{"text":" reads geometry from the buffer","type":"text"},{"text":" ","type":"text"},{"text":"as-presented to Vision — the selfie mirror flips the apparent","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"rotation):"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"yaw"}],"type":"strong"},{"type":"text","text":": POSITIVE = head turned to the user’s LEFT (subject’s"},{"type":"text","text":" "},{"type":"text","text":"POV), NEGATIVE = head turned to the user’s RIGHT. This is the"},{"type":"text","text":" "},{"type":"text","text":"opposite of the world-frame “right turn = positive” convention"},{"type":"text","text":" "},{"type":"text","text":"because the front-camera buffer is mirror-imaged before Vision"},{"type":"text","text":" "},{"type":"text","text":"sees it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"pitch","type":"text"}]},{"text":": positive = chin DOWN (face tilts towards the bottom","type":"text"},{"text":" ","type":"text"},{"text":"of the rotated buffer), negative = chin UP. This is the opposite","type":"text"},{"text":" ","type":"text"},{"text":"of the colloquial “looking up = positive” convention.","type":"text"}]}]}],"type":"unorderedList"}]}],"metadata":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PoseTarget"}],"modules":[{"name":"YEOFR"}],"externalID":"s:5YEOFR10PoseTargetO","title":"PoseTarget","symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PoseTarget","kind":"identifier"}],"roleHeading":"Enumeration"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/posetarget"]}],"abstract":[{"type":"text","text":"Target head orientation for one slot of a gallery enrollment."}],"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/PoseTarget/matches(yaw:pitch:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"matches"},{"kind":"text","text":"("},{"kind":"externalParam","text":"yaw"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"pitch"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"matches(yaw:pitch:)","url":"\/documentation\/yeofr\/posetarget\/matches(yaw:pitch:)","role":"symbol","kind":"symbol","abstract":[{"text":"True when the current head orientation matches this target.","type":"text"}],"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\