mplementations"]}],"relationshipsSections":[{"identifiers":["doc:\/\/com.youreyeonly.yeofr.YEOFR\/Se","doc:\/\/com.youreyeonly.yeofr.YEOFR\/SE","doc:\/\/com.youreyeonly.yeofr.YEOFR\/SQ","doc:\/\/com.youreyeonly.yeofr.YEOFR\/SH","doc:\/\/com.youreyeonly.yeofr.YEOFR\/SY","doc:\/\/com.youreyeonly.yeofr.YEOFR\/s8SendableP","doc:\/\/com.youreyeonly.yeofr.YEOFR\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"sections":[],"variants":[{"paths":["\/documentation\/yeofr\/posetarget"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PoseTarget"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Used by the Luxand gallery walk to gate per-pose capture on the"},{"type":"text","text":" "},{"type":"text","text":"user’s actual head orientation (Vision’s "},{"type":"codeVoice","code":"VNFaceObservation.yaw"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":".pitch"},{"type":"text","text":"). Without this gate the SDK would auto-advance within ~50 ms"},{"type":"text","text":" "},{"type":"text","text":"of pose acceptance — the user has no time to physically change"},{"type":"text","text":" "},{"type":"text","text":"orientation, so every captured appearance reflects the same head"},{"type":"text","text":" "},{"type":"text","text":"pose and the gallery gains no angular breadth."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Thresholds were picked to match the user’s normal head-turn range","type":"text"},{"text":" ","type":"text"},{"text":"during walking: a low ±7° on the yaw turn poses (Vision compresses","type":"text"},{"text":" ","type":"text"},{"text":"physical head rotation, so a larger gate forces an exaggerated turn —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"codeVoice","code":"yawThreshold"},{"type":"text","text":"), and a tight ±5° on "},{"type":"codeVoice","code":".front"},{"type":"text","text":" so it only matches"},{"type":"text","text":" "},{"type":"text","text":"when the user is genuinely centred while still leaving a 2° dead-band"},{"type":"text","text":" "},{"type":"text","text":"below the yaw gate. Vision reports yaw\/pitch in radians (≈ 0.26 rad"},{"type":"text","text":" "},{"type":"text","text":"per 15°)."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Vision sign conventions","type":"text"}]},{"type":"text","text":" on the rotated, mirrored front-camera"},{"type":"text","text":" "},{"type":"text","text":"portrait buffer ("},{"type":"codeVoice","code":"VNFaceObservation"},{"type":"text","text":" reads geometry from the buffer"},{"type":"text","text":" "},{"type":"text","text":"as-presented to Vision — the selfie mirror flips the apparent"},{"type":"text","text":" "},{"type":"text","text":"rotation):"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"yaw"}]},{"type":"text","text":": POSITIVE = head turned to the user’s LEFT (subject’s"},{"type":"text","text":" "},{"type":"text","text":"POV), NEGATIVE = head turned to the user’s RIGHT. This is the"},{"type":"text","text":" "},{"type":"text","text":"opposite of the world-frame “right turn = positive” convention"},{"type":"text","text":" "},{"type":"text","text":"because the front-camera buffer is mirror-imaged before Vision"},{"type":"text","text":" "},{"type":"text","text":"sees it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"pitch"}],"type":"strong"},{"text":": positive = chin DOWN (face tilts towards the bottom","type":"text"},{"text":" ","type":"text"},{"text":"of the rotated buffer), negative = chin UP. This is the opposite","type":"text"},{"text":" ","type":"text"},{"text":"of the colloquial “looking up = positive” convention.","type":"text"}]}]}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/EnrollmentProgress","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/LightingPhaseConfig"],"generated":true,"anchor":"Enrolment","title":"Enrolment"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget","interfaceLanguage":"swift"},"metadata":{"title":"PoseTarget","modules":[{"name":"YEOFR"}],"navigatorTitle":[{"kind":"identifier","text":"PoseTarget"}],"symbolKind":"enum","roleHeading":"Enumeration","externalID":"s:5YEOFR10PoseTargetO","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PoseTarget","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR"]]},"references":{"doc://com.youreyeonly.yeofr.YEOFR/SH":{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/PoseTarget/defaultGallerySequence":{"role":"symbol","title":"defaultGallerySequence","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/PoseTarget\/defaultGallerySequence","url":"\/documentation\/yeofr\/posetarget\/defaultgallerysequence","abstract":[{"type":"text","text":"Default sequence for a full 5-pose gallery enrollment."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultGallerySequence"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:5YEOFR10PoseTargetO","kind":"typeIdentifier","text":"PoseTarget"},{"kind":"text","text":"]"}]},"doc://com