{"hierarchy":{"paths":[["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession"]]},"kind":"symbol","identifier":{"url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/observedRates()","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/facetrustsession\/observedrates()"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"text":"Forward a TrueDepth verdict from the host’s depth pipeline","type":"text"},{"type":"text","text":" "},{"text":"into the evaluator. The session owns no camera or depth","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"hardware — depth wiring stays in the host (per the SDK"},{"type":"text","text":" "},{"type":"text","text":"boundary), but the per-frame trust decision needs the verdict to"},{"type":"text","text":" "},{"type":"text","text":"drive the depth-primary gate."},{"type":"text","text":" "},{"text":"What the three signals are ACTUALLY running at, against what the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline’s timing was derived from.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"observedRates"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"ObservedSignalRates","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/ObservedSignalRates","preciseIdentifier":"s:5YEOFR19ObservedSignalRatesV"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Every trust window is a frame count derived from the CONFIGURED rate,"},{"type":"text","text":" "},{"text":"deliberately — certification needs a reproducible operating point, and","type":"text"},{"text":" ","type":"text"},{"text":"a measured rate fed back would make timing drift with load. The","type":"text"},{"text":" ","type":"text"},{"text":"documented corollary is that a host whose real throughput differs","type":"text"},{"type":"text","text":" "},{"type":"text","text":"should SURFACE that difference. Nothing did, so a pipeline quietly"},{"type":"text","text":" "},{"text":"running at half its configured rate took twice as long to revoke","type":"text"},{"text":" ","type":"text"},{"text":"trust as it was tuned to, with nothing on screen saying so.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"observedRates"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5YEOFR19ObservedSignalRatesV","text":"ObservedSignalRates"}],"modules":[{"name":"YEOFR"}],"title":"observedRates()","roleHeading":"Instance Method","externalID":"s:5YEOFR16FaceTrustSessionC13observedRatesAA014ObservedSignalF0VyF","symbolKind":"method"},"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/ObservedSignalRates":{"url":"\/documentation\/yeofr\/observedsignalrates","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/ObservedSignalRates","role":"symbol","navigatorTitle":[{"text":"ObservedSignalRates","kind":"identifier"}],"abstract":[{"text":"A snapshot of configured-versus-actual for each signal.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ObservedSignalRates"}],"title":"ObservedSignalRates","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession":{"abstract":[{"type":"text","text":"A lower-level, camera-free trust pipeline: feed it frames with"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/processFrame(buffer:)","type":"reference"},{"text":" and read fused verdicts from","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/faceTrustStream()","isActive":true,"type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/yeofr\/facetrustsession","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FaceTrustSession","kind":"identifier"}],"navigatorTitle":[{"text":"FaceTrustSession","kind":"identifier"}],"title":"FaceTrustSession","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession","role":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/observedRates()":{"abstract":[{"text":"Forward a TrueDepth verdict from the host’s depth pipeline","type":"text"},{"text":" ","type":"text"},{"text":"into the evaluator. The session owns no camera or depth","type":"text"},{"text":" ","type":"text"},{"text":"hardware — depth wiring stays in the host (per the SDK","type":"text"},{"text":" ","type":"text"},{"text":"boundary), but the per-frame trust decision needs the verdict to","type":"text"},{"text":" ","type":"text"},{"text":"drive the depth-primary gate.","type":"text"},{"text":" ","type":"text"},{"text":"What the three signals are ACTUALLY running at, against what the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline’s timing was derived from.","type":"text"}],"url":"\/documentation\/yeofr\/facetrustsession\/observedrates()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"observedRates","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5YEOFR19ObservedSignalRatesV","text":"ObservedSignalRates","kind":"typeIdentifier"}],"title":"observedRates()","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/docume