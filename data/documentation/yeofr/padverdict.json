ype":"text","text":"offered and did not score (refused by the frame-quality gate, no"},{"type":"text","text":" "},{"type":"text","text":"crop) breaks it — the next one starts on the next CNN run."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PADVerdict\/spoof"},{"type":"text","text":" — no held second yet, and some frame of the presentation"},{"type":"text","text":" "},{"type":"text","text":"was denied (flat depth and\/or a CNN spoof verdict at the current"},{"type":"text","text":" "},{"type":"text","text":"operating point)."}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PADVerdict\/indeterminate"},{"type":"text","text":" — neither: warmup, or only non-evaluable frames"},{"type":"text","text":" "},{"type":"text","text":"(no-face, out of the depth window) so far."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"A presentation starts at construction, ","type":"text"},{"type":"codeVoice","code":"reset()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"softReset()"},{"text":" (face","type":"text"},{"text":" ","type":"text"},{"text":"loss) and ","type":"text"},{"code":"beginPresentation()","type":"codeVoice"},{"text":" (a new verification attempt). The","type":"text"},{"text":" ","type":"text"},{"text":"per-frame verdict feeding the rule reflects the same operating point the","type":"text"},{"text":" ","type":"text"},{"text":"live trust gate uses, with the face-recognition AND-gate removed; the","type":"text"},{"text":" ","type":"text"},{"text":"field is diagnostic and never alters ","type":"text"},{"code":"trusted","type":"codeVoice"},{"text":".","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR"]]},"metadata":{"externalID":"s:5YEOFR10PADVerdictO",