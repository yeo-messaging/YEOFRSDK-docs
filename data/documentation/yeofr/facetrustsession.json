ator on every","type":"text"},{"type":"text","text":" "},{"text":"frame and hides the rolling state (debounce, hysteresis, cold-start","type":"text"},{"text":" ","type":"text"},{"text":"bypass) behind the actor. Use this when you manage the camera yourself;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise prefer the turnkey ","type":"text"},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustService","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"seeAlsoSections":[{"title":"Lower-level engine","identifiers":["doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOFRSDK","doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOFRCameraSession"],"generated":true,"anchor":"Lower-level-engine"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/facetrustsession"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession"},"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/applyLivenessCalibration(_:)":{"abstract":[{"type":"text","text":"Apply (or, with "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", clear) a persisted per-user calibration."},{"type":"text","text":" "},{"type":"text","text":"Only the genuine-admit threshold moves, clamped to"},{"type":"text","text":" "},{"type":"codeVoice","code":"[YEOLivenessCalibration.floorLiveEnter, default]"},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"spoof-enter bar and the confident-spoof veto are never affected."},{"type":"text","text":" "},{"type":"text","text":"Call with "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" whenever the enrollment it was derived from is"},{"type":"text","text":" "},{"type":"text","text":"deleted."}],"kind":"symbol","url":"\/documentation\/yeofr\/facetrustsession\/applylivenesscalibration(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"applyLivenessCalibration"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"YEOLivenessCalibration","preciseIdentifier":"s:5YEOFR22YEOLivenessCalibrationV"},{"kind":"text","text":"?)"}],"title":"applyLivenessCalibration(_:)","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/applyLivenessCalibration(_:)","role":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/Actor-Implementations":{"abstract":[],"kind":"article","url":"\/documentation\/yeofr\/facetrustsession\/actor-implementations","title":"Actor Implementations","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/Actor-Implementations","role":"collectionGroup"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/recordDepth(_:)":{"abstract":[],"kind":"symbol","url":"\/documentation\/yeofr\/facetrustsession\/recorddepth(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"recordDepth"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"YEOFRDepthVerdict","preciseIdentifier":"s:5YEOFR17YEOFRDepthVerdictO"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"title":"recordDepth(_:)","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/recordDepth(_:)","role":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/ScA":{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/ScA","title":"_Concurrency.Actor","type":"unresolvable"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/beginLivenessCalibrationCapture()":{"abstract":[{"type":"text","text":"Arm the enrollment-time liveness score capture. Call when an"},{"type":"text","text":" "},{"type":"text","text":"enrollment pose sweep starts; every scored raw P(live)"},{"type":"text","text":" "},{"type":"text","text":"score is banked until "},{"type":"codeVoice","code":"finishLivenessCalibrationCapture()"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/yeofr\/facetrustsession\/beginlivenesscalibrationcapture()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"beginLivenessCalibrationCapture"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"}],"title":"beginLivenessCalibrationCapture()","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/beginLivenessCalibrationCapture()","role":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"abstract":[{"type":"text","text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing."}],"url":"\/documentation\/yeofr","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","role":"collection","type":"topic","kind":"symbol","title":"YEOFR"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/setFusionConfig(_:)":{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/setFusionConfig(_:)","abstract":[{"type":"text","text":"Update the fusion toggles. The session stores its own copy to"},{"type":"text","text":" "},{"type":"text","text":"physically gate the non-recognition work in "},{"type":"codeVoice","code":"processFrame"},{"type":"text","text":" (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"fusionConfig"},{"type":"text","text":"); the evaluator’s copy governs "},{"type":"codeVoice","code":"evaluateFusedTrust"},{"type":"text","text":"."}],"title":"setFusionConfig(_:)","kind":"symbol","type":"topic","url":"\/documentation\/yeofr\/facetrustsession\/setfusionconfig(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"setFusionConfig"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"LivenessFusionConfigurable","preciseIdentifier":"s:5YEOFR26LivenessFusionConfigurableP"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/beginVerificationAttempt()":{"abstract":[{"type":"text","text":"Drop accumulated trust + signal state. Call when the upstream"},{"type":"text","text":" "},{"type":"text","text":"tracker reports a new face ID mid-session, so the new face"},{"type":"text","text":" "},{"type":"text","text":"evaluates from cold instead of inheriting the previous user’s"},{"type":"text","text":" "},{"type":"text","text":"verdicts."},{"type":"text","text":" "},{"type":"text","text":"Starts a new verification attempt: the liveness evidence and the"},{"type":"text","text":" "},{"type":"text","text":"presentation grade start over. A host calls this as each"},{"type":"text","text":" "},{"type":"text","text":"transaction begins: the one-shot decision mode otherwise replays the"},{"type":"text","text":" "},{"type":"text","text":"first attempt’s verdict, and the presentation-graded "},{"type":"codeVoice","code":"padVerdict"},{"type":"text","text":" "},{"type":"text","text":"would otherwise carry a held second from one attempt into the next."}],"kind":"symbol","url":"\/documentation\/yeofr\/facetrustsession\/beginverificationattempt()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"beginVerificationAttempt"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"title":"beginVerificationAttempt()","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/beginVerificationAttempt()","role":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/processFrame(buffer:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"processFrame","kind":"identifier"},{"text":"(","kind":"text"},{"text":"buffer","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CVPixelBuffer","preciseIdentifier":"c:@T@CVPixelBufferRef","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"FaceTrustFrameResult","preciseIdentifier":"s:5YEOFR20FaceTrustFrameResultV","kind":"typeIdentifier"}],"url":"\/documentation\/yeofr\/facetrustsession\/processframe(buffer:)","kind":"symbol","role":"symbol","type":"topic","title":"processFrame(buffer:)","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/processFrame(buffer:)","abstract":[{"text":"Run one frame through the fusion pipeline. The returned","type":"text"},{"text":" ","type":"text"},{"code":"detection","type":"codeVoice"},{"text":" is sync and authoritative for this frame; the","type":"text"},{"text":" ","type":"text"},{"text":"returned ","type":"text"},{"code":"evaluation","type":"codeVoice"},{"text":" is the latest trust state (it may not","type":"text"},{"text":" ","type":"text"},{"text":"include this frame’s CNN verdict yet since the CNN runs","type":"text"},{"text":" ","type":"text"},{"text":"off-actor on a detached task).","type":"text"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession":{"abstract":[{"type":"text","text":"A lower-level, camera-free trust pipeline: feed it frames with"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/processFrame(buffer:)","type":"reference"},{"text":" and read fused verdicts from","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/faceTrustStream()","isActive":true,"type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/yeofr\/facetrustsession","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FaceTrustSession","kind":"identifier"}],"navigatorTitle":[{"text":"FaceTrustSession","kind":"identifier"}],"title":"FaceTrustSession","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession","role":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/setModelInputCapture(_:)":{"role":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/setModelInputCapture(_:)","abstract":[{"type":"text","text":"Attach the images the two models read to every"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustFrameResult","type":"reference","isActive":true},{"type":"text","text":" ("},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustFrameResult\/livenessInput","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustFrameResult\/recognitionInput","type":"reference","isActive":true},{"type":"text","text":") — a diagnostic for a host"},{"type":"text","text":" "},{"type":"text","text":"that shows them. Off by default: keeping the liveness patch costs a"},{"type":"text","text":" "},{"type":"text","text":"render per scored CNN run. Switching it does not reset the session."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setModelInputCapture"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"title":"setModelInputCapture(_:)","kind":"symbol","url":"\/documentation\/yeofr\/facetrustsession\/setmodelinputcapture(_:)","type":"topic"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/observedRates()":{"abstract":[{"text":"Forward a TrueDepth verdict from the host’s depth pipeline","type":"text"},{"text":" ","type":"text"},{"text":"into the evaluator. The session owns no camera or depth","type":"text"},{"text":" ","type":"text"},{"text":"hardware — depth wiring stays in the host (per the SDK","type":"text"},{"text":" ","type":"text"},{"text":"boundary), but the per-frame trust decision needs the verdict to","type":"text"},{"text":" ","type":"text"},{"text":"drive the depth-primary gate.","type":"text"},{"text":" ","type":"text"},{"text":"What the three signals are ACTUALLY running at, against what the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline’s timing was derived from.","type":"text"}],"url":"\/documentation\/yeofr\/facetrustsession\/observedrates()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"observedRates","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5YEOFR19ObservedSignalRatesV","text":"ObservedSignalRates","kind":"typeIdentifier"}],"title":"observedRates()","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/observedRates()","role":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/finishLivenessCalibrationCapture()":{"abstract":[{"type":"text","text":"Finish the capture, derive this user’s calibration and apply it."},{"type":"text","text":" "},{"type":"text","text":"Returns the calibration for the HOST to persist alongside its"},{"type":"text","text":" "},{"type":"text","text":"enrollment record (and re-apply via"},{"type":"text","text":" "},{"type":"codeVoice","code":"applyLivenessCalibration(_:)"},{"type":"text","text":" on the next launch), or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"no calibration is warranted (too few scores, or the user’s"},{"type":"text","text":" "},{"type":"text","text":"baseline already clears the default threshold) — in which case"},{"type":"text","text":" "},{"type":"text","text":"any previously applied calibration is cleared."}],"kind":"symbol","url":"\/documentation\/yeofr\/facetrustsession\/finishlivenesscalibrationcapture()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"finishLivenessCalibrationCapture"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"YEOLivenessCalibration","preciseIdentifier":"s:5YEOFR22YEOLivenessCalibrationV"},{"kind":"text","text":"?"}],"title":"finishLivenessCalibrationCapture()","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/finishLivenessCalibrationCapture()","role":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustSession/stillPADResult(image:faceRect:)":{"url":"\/documentation\/yeofr\/facetrustsession\/stillpadresult(image:facerect:)","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/stillPADResult(image:faceRect:)","role":"symbol","abstract":[{"type":"text","text":"One-shot MiniFASNet PAD result for a still image — no camera frame,"},{"type":"text","text":" "},{"type":"text","text":"no evaluator\/trust fusion, just the raw CNN “live” probability and the"},{"type":"text","text":" "},{"type":"text","text":"verdict the live pipeline’s own rule gives it, for offline bulk"},{"type":"text","text":" "},{"type":"text","text":"verification. That rule is the selected model’s own live bar, so a"},{"type":"text","text":" "},{"type":"text","text":"SCORED still is genuine or spoof and never uncertain. Score is"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and verdict "},{"type":"codeVoice","code":".indeterminate"},{"type":"text","text":" when no face could be cropped, or"},{"type":"text","text":" "},{"type":"text","text":"when the face sits so close to the frame edge that its context crop"},{"type":"text","text":" "},{"type":"text","text":"was clipped (bad PAD input). Pass "},{"type":"codeVoice","code":"faceRect"},{"type":"text","text":" (pixel space) when you"},{"type":"text","text":" "},{"type":"text","text":"already have a face rect (e.g. from the offline still matcher) to"},{"type":"text","text":" "},{"type":"text","text":"skip Vision detection."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stillPADResult"},{"kind":"text","text":"("},{"kind":"externalParam","text":"image"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CIImage","preciseIdentifier":"c:objc(cs)CIImage"},{"kind":"text","text":", "},{"kind":"externalParam","text":"faceRect"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGRect","preciseIdentifier":"c:@S@CGRect"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> (score"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Float","preciseIdentifier":"s:Sf"},{"kind":"text","text":"?, verdict"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PADVerdict","preciseIdentifier":"s:5YEOFR10PADVerdictO"},{"kind":"text","text":")"}],"title":"stillPADResult(image:faceRect:)","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/FaceTrustFrameResult/livenessInput":{"role":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustFrameResult\/livenessInput","abstract":[{"text":"The image the liveness CNN last scored, exactly as its input tensor","type":"text"},{"text":" ","type":"text"},{"text":"was built from it: the narrow context crop, resampled to the","type":"text"},{"type":"text","text":" "},{"text":"model’s input size (260×260 for the EfficientNet-B2 heads, 80×80 for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the MiniFASNet family), in buffer orientation — not mirrored. The CNN"},{"type":"text","text":" "},{"type":"text","text":"runs asynchronously and not on every frame, so this is the latest"},{"text":" ","type":"text"},{"type":"text","text":"SCORED patch, typically a frame behind; "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" until one is scored"},{"text":" ","type":"text"},{"text":"since the last reset or configuration, and whenever","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/setModelInputCapture(_:)","isActive":true,"type":"reference"},{"text":" is off. A two-head","type":"text"},{"text":" ","type":"text"},{"text":"model’s wide crop is not included.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"livenessInput"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@CGImageRef","text":"CGImage"},{"kind":"text","text":"?"}],"title":"livenessInput","kind":"symbol","url":"\/documentation\/yeofr\/facetrustframeresult\/livenessinput","type":"topic"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOFRCameraSession":{"url":"\/documentation\/yeofr\/yeofrcamerasession","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOFRCameraSession","role":"symbol","navigatorTitle":[{"text":"YEOFRCameraSession","kind":"identifier"}],"abstract":[{"text":"Manages the front-camera ","type":"text"},{"code":"AVCaptureSession","type":"codeVoice"},{"text":" and feeds frames — plus","type":"text"},{"text":" ","type":"text"},{"text":"TrueDepth, on supported devices — into the trust pipeline.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YEOFRCameraSession","kind":"identifier"}],"title":"YEOFRCameraSession","type":"topic","kind":"symbol"},"doc://com.youreyeonly.yeofr.YEOFR/s8SendableP":{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/s8Sen