xt","text":" when this frame did not read the verdict it carries: the"},{"type":"text","text":" "},{"type":"text","text":"detector holds its last confirmed verdict across frames that read the"},{"type":"text","text":" "},{"type":"text","text":"other one, or nothing gradable, so a display does not flicker. It was"},{"type":"text","text":" "},{"type":"text","text":"decided on whatever was in front of the sensor then. A transaction’s"},{"type":"text","text":" "},{"type":"text","text":"3D result does not count it; the trust gate and the flat run that"},{"type":"text","text":" "},{"type":"text","text":"denies still do, as they always have."}],"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCarriedOver","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"isCarriedOver","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOFRDepthVerdictDetail\/isCarriedOver","type":"topic"}}}