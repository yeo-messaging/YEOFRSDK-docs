aults.padModel"},{"type":"text","text":")."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"quinceE32Veto"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"}],"metadata":{"roleHeading":"Case","externalID":"s:5YEOFR11YEOPADModelO13quinceE32VetoyA2CmF","role":"symbol","modules":[{"name":"YEOFR"}],"title":"YEOPADModel.quinceE32Veto","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"quinceE32Veto"}],"symbolKind":"case"},"references":{"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR":{"abstract":[{"type":"text","text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing."}],"url":"\/documentation\/yeofr","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR","role":"collection","type":"topic","kind":"symbol","title":"YEOFR"},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel":{"role":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel","abstract":[{"text":"The anti-spoof model the liveness pipeline runs.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"YEOPADModel"}],"type":"topic","title":"YEOPADModel","url":"\/documentation\/yeofr\/yeopadmodel","kind":"symbol","navigatorTitle":[{"text":"YEOPADModel","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/papayaPearE32":{"abstract":[{"type":"text","text":"Papaya + Pear (E32) — "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":" with the Papaya half swapped for"},{"type":"text","text":" "},{"type":"text","text":"E32 (epoch 27): the same MiniFASNetV2 backbone deciding through a"},{"type":"text","text":" "},{"type":"text","text":"binary Live\/Spoof head (2 logits, live = index 0). Pear is the same"},{"type":"text","text":" "},{"type":"text","text":"E25B_v2 head "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":" bundles. Crops, input size, equal-weight"},{"type":"text","text":" "},{"type":"text","text":"fusion and the Candidate B rolling policy are "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":"‘s; only"},{"type":"text","text":" "},{"type":"text","text":"the Papaya weights differ. An evaluation entry beside "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"matching Android’s "},{"type":"codeVoice","code":"PapayaPearGeneration.E32"},{"type":"text","text":" (YWLA-847)."}],"kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPearE32","type":"topic","url":"\/documentation\/yeofr\/yeopadmodel\/papayapeare32","role":"symbol","title":"YEOPADModel.papayaPearE32","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"papayaPearE32"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/papayaPear":{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear","abstract":[{"type":"text","text":"Papaya + Pear, score-averaged — the same w=0.5 late fusion "},{"type":"codeVoice","code":"base"},{"type":"text","text":" "},{"type":"text","text":"uses, over the two fine-tuned models."}],"title":"YEOPADModel.papayaPear","kind":"symbol","type":"topic","url":"\/documentation\/yeofr\/yeopadmodel\/papayapear","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"papayaPear","kind":"identifier"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/quinceE32Veto":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"quinceE32Veto"}],"url":"\/documentation\/yeofr\/yeopadmodel\/quincee32veto","kind":"symbol","role":"symbol","title":"YEOPADModel.quinceE32Veto","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE32Veto","abstract":[{"type":"text","text":"Quince + E32 veto — "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE25Veto","type":"reference","isActive":true},{"type":"text","text":" with "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPearE32","type":"reference","isActive":true},{"type":"text","text":" as the"},{"type":"text","text":" "},{"type":"text","text":"veto head, under the same rule and the same 0.35 bar (fitted with"},{"type":"text","text":" "},{"type":"text","text":"E25 v2, not re-fitted for E32). Android’s "},{"type":"codeVoice","code":"combined-qe32"},{"type":"text","text":" "},{"type":"text","text":"(feature\/YWLA-847-box-map-menu, 87f0e55), except that its decider is"},{"type":"text","text":" "},{"type":"text","text":"Quince V2 (ep98, 5-class, "},{"type":"codeVoice","code":"PADModelFile\/quince"},{"type":"text","text":") where "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quince","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"is V1, and its "},{"type":"codeVoice","code":"seq-8"},{"type":"text","text":" runs at rho 0.91 here"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"PADRollingMeanPolicy\/quince"},{"type":"text","text":") and still at 0.96 on Android. The"},{"type":"text","text":" "},{"type":"text","text":"default ("},{"type":"codeVoice","code":"LivenessFusionDefaults.padModel"},{"type":"text","text":")."}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/quinceE25Veto":{"abstract":[{"type":"text","text":"Quince + E25 v2 veto — Android’s "},{"type":"codeVoice","code":"combined-qe25"},{"type":"text","text":" (YWLA-847). Two"},{"type":"text","text":" "},{"type":"text","text":"heads score every frame on the same face box, each on its own crops"},{"type":"text","text":" "},{"type":"text","text":"and under its own policy exactly as it runs alone (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"combinedHeads"},{"type":"text","text":"): "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quince"},{"type":"text","text":" (fp32) decides, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/papayaPear"},{"type":"text","text":" "},{"type":"text","text":"(E25 v2, equal fusion, its 1 s revoke hold and 0.1 s cadence gate)"},{"type":"text","text":" "},{"type":"text","text":"vetoes when it has decided spoof on a raw P(live) below"},{"type":"text","text":" "},{"type":"codeVoice","code":"PADVetoRule.vetoBar"},{"type":"text","text":" (0.35, chosen post hoc on office takes, not a"},{"type":"text","text":" "},{"type":"text","text":"pre-registered value). Evaluation only."}],"kind":"symbol","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE25Veto","type":"topic","url":"\/documentation\/yeofr\/yeopadmodel\/quincee25veto","role":"symbol","title":"YEOPADModel.quinceE25Veto","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"quinceE25Veto"}]},"doc://com.youreyeonly.yeofr.YEOFR/documentation/YEOFR/YEOPADModel/quince":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"quince"}],"url":"\/documentation\/yeofr\/yeopadmodel\/quince","kind":"symbol","role":"symbol","title":"YEOPADModel.quince","type":"topic","identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quince","abstract":[{"type":"text","text":"Quince — Coconut retrained with the live class weighted above the"},{"type":"text","text":" "},{"type":"text","text":"attack classes in the loss, to lift its genuine acceptance. Same"},{"type":"text","text":" "},{"type":"text","text":"EfficientNet-B2, 2.7× crop, 260×260 input, 7-class head and "},{"type":"codeVoice","code":"seq-8"},{"type":"text","text":" "},{"type":"text","text":"rule; only the weights differ. Delivered 2026-09-19; internal VAL"},{"type":"text","text":" "},{"type":"text","text":"only (balanced 95.9 %). Quince V1 ("},{"type":"codeVoice","code":"PADModelFile\/quinceV1"},{"type":"text","text":"):"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.youreyeonly.yeofr.YEOFR\/documentation\/YEOFR\/YEOPADModel\/quinceE32Veto","type":"reference","isActive":true},{"type":"text","text":" decides on V2 instead."}]}}}