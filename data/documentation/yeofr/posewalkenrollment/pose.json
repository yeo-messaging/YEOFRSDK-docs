]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sign conventions (radians, as the host’s face reader reports them):"},{"type":"text","text":" "},{"type":"text","text":"yaw POSITIVE = head turned to the user’s LEFT; pitch POSITIVE = chin"},{"type":"text","text":" "},{"type":"text","text":"DOWN. Face readers compress physical rotation, so the gates are small:"},{"type":"text","text":" "},{"type":"text","text":"±7° yaw and ±4° pitch for the turns. "},{"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PoseWalkEnrollment\/Pose\/front","isActive":true},{"type":"text","text":" sits strictly inside"},{"type":"text","text":" "},{"type":"text","text":"both with a dead band (±5° yaw, ±3° pitch) so a centred face and a"},{"type":"text","text":" "},{"type":"text","text":"turned one never fill each other’s buckets. Unreadable angles match"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PoseWalkEnrollment\/Pose\/front","isActive":true},{"type":"text","text":" (readers often cannot estimate a near-frontal face) and never"},{"type":"text","text":" "},{"type":"text","text":"match a turn."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PoseWalkEnrollment\/Pose"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/posewalkenrollment\/pose"]}],"references":{"doc://com.yeomessaging.YEOFR/documentation/YEOFR/PoseWalkEnrollment/Pose/yawRight":{"fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"yawRight","kind":"identifier"}],"abstract":[],"url":"\/documentation\/yeofr\/posewalkenrollment\/pose\/yawright","type":"topic","kind":"symbol","title":"PoseWalkEnrollment.Pose.yawRight","identifier":"doc:\/\/com.yeomessaging.YEOFR\/docu