dels cannot grade keeps"},{"type":"text","text":" "},{"type":"text","text":"the last verdict for up to 1.5 s, as Android does. Read the answer"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"result.isLive"},{"type":"text","text":" (one detected face, "},{"type":"codeVoice","code":"isConfident()"},{"type":"text","text":"). A face gone"},{"type":"text","text":" "},{"type":"text","text":"for "},{"type":"codeVoice","code":"FrameCadence.faceLossDebounceSeconds"},{"type":"text","text":" empties the session, so"},{"type":"text","text":" "},{"type":"text","text":"the next face is judged on its own frames."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOFRSDK"]]},"identifier":{"url":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOFRSDK\/detectFaces(params:needFaceRect:isolation:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/yeofr\/yeofrsdk\/detectfaces(params:needfacerect:isolation:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.yeomessaging.YEOFR/documentation/YEOFR/ImageFrameParameters":{"role":"symbol","title":"ImageFrameParameters","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImageFrameParameters","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/yeofr\/imageframeparameters","type":"topic","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/ImageFrameParameters","abstract":[{"type":"text","text":"Public (0.5.5 surface shape): the Flutter bridge constructs frame"},{"type":"text","text":" "},{"type":"text","text":"params via "},{"type":"codeVoice","code":"imageParameter(forImageBuffer:)"},{"type":"text","text":" and feeds "},{"type":"codeVoice","code":"detectFaces"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"ImageFrameParameters","kind":"identifier"}]},"doc://com.yeomes