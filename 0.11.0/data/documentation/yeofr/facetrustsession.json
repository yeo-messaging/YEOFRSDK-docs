ecognitionInput":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"recognitionInput","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@CGImageRef","text":"CGImage","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The aligned 112×112 face the recognition embedder read this frame;"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the frame was not graded (rate-skipped, no face, or no"},{"type":"text","text":" "},{"type":"text","text":"landmarks to align on) and whenever"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/setModelInputCapture(_:)"},{"type":"text","text":" is off."}],"url":"\/documentation\/yeofr\/facetrustframeresult\/recognitioninput","type":"topic","kind":"symbol","title":"recognitionInput","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustFrameResult\/recognitionInput","role":"symbol"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustFrameResult/livenessInput":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"livenessInput","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@CGImageRef","text":"CGImage","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"text":"The image the liveness CNN last scored, exactly as its input tensor","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"was built from it: the narrow context crop, resampled to the"},{"text":" ","type":"text"},{"text":"model’s input size (260×260 for the EfficientNet-B2 heads, 80×80 for","type":"text"},{"type":"text","text":" "},{"text":"the MiniFASNet family), in buffer orientation — not mirrored. The CNN","type":"text"},{"text":" ","type":"text"},{"text":"runs asynchronously and not on every frame, so this is the latest","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"SCORED patch, typically a frame behind; "},{"code":"nil","type":"codeVoice"},{"text":" until one is scored","type":"text"},{"type":"text","text":" "},{"type":"text","text":"since the last reset or configuration, and whenever"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/setModelInputCapture(_:)"},{"type":"text","text":" is off. A two-head"},{"type":"text","text":" "},{"type":"text","text":"model’s wide crop is not included."}],"url":"\/documentation\/yeofr\/facetrustframeresult\/livenessinput","type":"topic","kind":"symbol","title":"livenessInput","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustFrameResult\/livenessInput","role":"symbol"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustSession/stillPADResult(image:faceRect:)":{"url":"\/documentation\/yeofr\/facetrustsession\/stillpadresult(image:facerect:)","abstract":[{"type":"text","text":"One-shot PAD result for a still image — no camera frame,"},{"type":"text","text":" "},{"type":"text","text":"no evaluator\/trust fusion, just the raw CNN “live” probability and the"},{"type":"text","text":" "},{"type":"text","text":"verdict the live pipeline’s own rule gives it, for offline bulk"},{"type":"text","text":" "},{"type":"text","text":"verification. That rule is Quince’s own per-frame read, so a SCORED"},{"type":"text","text":" "},{"type":"text","text":"still is genuine or spoof and never uncertain. Score is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"verdict "},{"type":"codeVoice","code":".indeterminate"},{"type":"text","text":" when no face could be cropped or a head"},{"type":"text","text":" "},{"type":"text","text":"produced no score. Pass "},{"type":"codeVoice","code":"faceRect"},{"type":"text","text":" (pixel space) when you already have"},{"type":"text","text":" "},{"type":"text","text":"a face rect (e.g. from the offline still matcher) to skip Vision"},{"type":"text","text":" "},{"type":"text","text":"detection."}],"title":"stillPADResult(image:faceRect:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stillPADResult","kind":"identifier"},{"text":"(","kind":"text"},{"text":"image","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CIImage","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)CIImage"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"faceRect"},{"text":": ","kind":"text"},{"text":"CGRect","kind":"typeIdentifier","preciseIdentifier":"c:@S@CGRect"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> (score","kind":"text"},{"text":": ","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"},{"text":"?, verdict","kind":"text"},{"text":": ","kind":"text"},{"text":"PADVerdict","kind":"typeIdentifier","preciseIdentifier":"s:5YEOFR10PADVerdictO"},{"text":")","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/stillPADResult(image:faceRect:)"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/YEOFRSDK":{"url":"\/documentation\/yeofr\/yeofrsdk","title":"YEOFRSDK","abstract":[{"text":"YEOFR main entry point.","type":"text"}],"role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YEOFRSDK","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOFRSDK","navigatorTitle":[{"kind":"identifier","text":"YEOFRSDK"}]},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/YEOFRCameraSession":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"YEOFRCameraSession"}],"abstract":[{"type":"text","text":"Manages the front-camera "},{"code":"AVCaptureSession","type":"codeVoice"},{"type":"text","text":" and feeds frames — plus"},{"type":"text","text":" "},{"type":"text","text":"TrueDepth, on supported devices — into the trust pipeline."}],"url":"\/documentation\/yeofr\/yeofrcamerasession","navigatorTitle":[{"kind":"identifier","text":"YEOFRCameraSession"}],"type":"topic","kind":"symbol","title":"YEOFRCameraSession","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOFRCameraSession","role":"symbol"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustSession/observedRates()":{"url":"\/documentation\/yeofr\/facetrustsession\/observedrates()","title":"observedRates()","abstract":[{"type":"text","text":"Forward a TrueDepth verdict from the host’s depth pipeline"},{"type":"text","text":" "},{"type":"text","text":"into the evaluator. The session owns no camera or depth"},{"type":"text","text":" "},{"type":"text","text":"hardware — depth wiring stays in the host (per the SDK"},{"type":"text","text":" "},{"type":"text","text":"boundary), but the per-frame trust decision needs the verdict to"},{"type":"text","text":" "},{"type":"text","text":"drive the depth-primary gate."},{"type":"text","text":" "},{"type":"text","text":"What the three signals are ACTUALLY running at, against what the"},{"type":"text","text":" "},{"type":"text","text":"pipeline’s timing was derived from."}],"role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"observedRates","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ObservedSignalRates","preciseIdentifier":"s:5YEOFR19ObservedSignalRatesV","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/observedRates()"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustSession/setEnrollmentActive(_:)":{"abstract":[{"type":"text","text":"Tell the session whether an enrollment is active. When "},{"type":"codeVoice","code":"true"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the trust verdict requires that at least one detected face"},{"type":"text","text":" "},{"type":"text","text":"matches the enrolled identity. When "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (pre-enrollment or"},{"type":"text","text":" "},{"type":"text","text":"after clearing the tracker), the recognition gate is inert and"},{"type":"text","text":" "},{"type":"text","text":"trust is determined purely by liveness signals."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/setEnrollmentActive(_:)","url":"\/documentation\/yeofr\/facetrustsession\/setenrollmentactive(_:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setEnrollmentActive","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"setEnrollmentActive(_:)"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustSession":{"abstract":[{"text":"A lower-level, camera-free trust pipeline: feed it frames with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/processFrame(buffer:)","isActive":true,"type":"reference"},{"text":" and read fused verdicts from","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/faceTrustStream()","isActive":true,"type":"reference"},{"text":".","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"FaceTrustSession","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession","url":"\/documentation\/yeofr\/facetrustsession","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FaceTrustSession","kind":"identifier"}],"title":"FaceTrustSession"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustSession/Actor-Implementations":{"url":"\/documentation\/yeofr\/facetrustsession\/actor-implementations","title":"Actor Implementations","abstract":[],"role":"collectionGroup","type":"topic","kind":"article","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/Actor-Implementations"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustSession/clipPADResult(frames:frameInterval:)":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"One-shot PAD result for a RECORDED CLIP, for offline bulk verification"},{"type":"text","text":" "},{"type":"text","text":"of videos — the sibling of "},{"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/stillPADResult(image:faceRect:)","isActive":true},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"case a still cannot cover. "},{"type":"codeVoice","code":"frames"},{"type":"text","text":" are the clip’s frames in order,"},{"type":"text","text":" "},{"type":"text","text":"sampled "},{"type":"codeVoice","code":"frameInterval"},{"type":"text","text":" apart (10 Hz by default, the rate the"},{"type":"text","text":" "},{"type":"text","text":"rolling decision policies were measured at)."},{"type":"text","text":" "},{"type":"text","text":"The clip is graded as one presentation over the model’s own live"},{"type":"text","text":" "},{"type":"text","text":"decision rule: "},{"type":"codeVoice","code":".genuine"},{"type":"text","text":" iff its standing verdict held genuine"},{"type":"text","text":" "},{"type":"text","text":"for one uninterrupted span of at least 1.0 s of the clip’s own"},{"type":"text","text":" "},{"type":"text","text":"timeline; otherwise "},{"type":"codeVoice","code":".spoof"},{"type":"text","text":" if it was ever spoof; otherwise"},{"type":"text","text":" "},{"type":"codeVoice","code":".indeterminate"},{"type":"text","text":". "},{"type":"codeVoice","code":"score"},{"type":"text","text":" is the last scored frame’s live"},{"type":"text","text":" "},{"type":"text","text":"probability. Frames with no detectable face break a genuine span and"},{"type":"text","text":" "},{"type":"text","text":"are not scored. No evaluator or trust fusion is involved."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clipPADResult","kind":"identifier"},{"text":"(","kind":"text"},{"text":"frames","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"CIImage","preciseIdentifier":"c:objc(cs)CIImage","kind":"typeIdentifier"},{"text":"], ","kind":"text"},{"text":"frameInterval","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> (score","kind":"text"},{"text":": ","kind":"text"},{"text":"Float","preciseIdentifier":"s:Sf","kind":"typeIdentifier"},{"text":"?, verdict","kind":"text"},{"text":": ","kind":"text"},{"text":"PADVerdict","preciseIdentifier":"s:5YEOFR10PADVerdictO","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"clipPADResult(frames:frameInterval:)","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/clipPADResult(frames:frameInterval:)","url":"\/documentation\/yeofr\/facetrustsession\/clippadresult(frames:frameinterval:)"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustSession/faceTrustStream()":{"abstract":[{"text":"Subscribe to the rolling trust verdict stream. The current","type":"text"},{"text":" ","type":"text"},{"code":"FaceEvaluationResult","type":"codeVoice"},{"text":" is yielded immediately on subscribe;","type":"text"},{"text":" ","type":"text"},{"text":"subsequent values fire whenever observable state changes","type":"text"},{"text":" ","type":"text"},{"text":"(trust, depth, liveness, face counts, anti-spoof signals).","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/faceTrustStream()","url":"\/documentation\/yeofr\/facetrustsession\/facetruststream()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"faceTrustStream","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"FaceEvaluationResult","preciseIdentifier":"s:5YEOFR20FaceEvaluationResultV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"faceTrustStream()"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR":{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","abstract":[{"text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing.","type":"text"}],"role":"collection","title":"YEOFR","type":"topic","kind":"symbol","url":"\/documentation\/yeofr"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustSession/beginVerificationAttempt()":{"abstract":[{"type":"text","text":"Drop accumulated trust + signal state. Call when the upstream"},{"type":"text","text":" "},{"type":"text","text":"tracker reports a new face ID mid-session, so the new face"},{"type":"text","text":" "},{"type":"text","text":"evaluates from cold instead of inheriting the previous user’s"},{"type":"text","text":" "},{"type":"text","text":"verdicts."},{"type":"text","text":" "},{"type":"text","text":"Starts a new verification attempt: the liveness evidence and the"},{"type":"text","text":" "},{"type":"text","text":"presentation grade start over. A host calls this as each"},{"type":"text","text":" "},{"type":"text","text":"transaction begins: the one-shot decision mode otherwise replays the"},{"type":"text","text":" "},{"type":"text","text":"first attempt