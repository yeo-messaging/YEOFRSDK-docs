xt","text":"."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setFusionConfig","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LivenessFusionConfigurable","preciseIdentifier":"s:5YEOFR26LivenessFusionConfigurableP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"setFusionConfig(_:)","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustSession\/setFusionConfig(_:)","url":"\/documentation\/yeofr\/facetrustsession\/setfusionconfig(_:)"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustService":{"abstract":[{"text":"Turnkey entry point for on-device face recognition with fused liveness","type":"text"},{"text":" ","type":"text"},{"text":"and TrueDepth anti-spoofing.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"FaceTrustService","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FaceTrustService","url":"\/documentation\/yeofr\/facetrustservice","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FaceTrustService","kind":"identifier"}],"title":"FaceTrustService"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/FaceTrustFrameResult":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FaceTrustFrameResult","kind":"identifier"}],"abstract":[{"type":"text","text":"Result of a single "},{"type":"codeVoice","code":"processFrame"},{"type":"text","text":" invocation. The detection half"},{"type":"text","text":" "},{"type":"text","text":"is the synchronous FR pass for this frame; the evaluation half is"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"emphasis","inlineContent":[{"text":"latest","type":"text"}]},{"type":"text","text":" trust verdict (which may incorporate prior frames’"},{"type":"text","text":" "},{