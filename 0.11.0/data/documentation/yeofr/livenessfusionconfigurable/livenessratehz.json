{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The rate the LIVENESS signal runs at, when it should run slower than"},{"type":"text","text":" "},{"type":"text","text":"the pipeline. "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" — the default — follows "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"livenessRateHz","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":"? { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Declaring a rate does two things together, and they are one change:"},{"type":"text","text":" "},{"type":"text","text":"frames are admitted to the CNN at that rate, and every liveness"},{"type":"text","text":" "},{"type":"text","text":"window is derived from it. Gating without retuning would stretch"},{"text":" ","type":"text"},{"type":"text","text":"spoof evidence in wall clock while the genuine admit stayed floored"},{"type":"text","text":" "},{"type":"text","text":"at one frame — a skew entirely toward admitting."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only ever slower. A value above "},{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz","isActive":true,"type":"reference"},{"text":" is clamped, because","type":"text"},{"text":" ","type":"text"},{"text":"no signal can run more often than frames arrive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"TrueDepth has no equivalent and deliberately so: it is produced in","type":"text"},{"text":" ","type":"text"},{"text":"the TrueDepth synchronizer callback, throttled to its own ceiling,","type":"text"},{"text":" ","type":"text"},{"text":"and never enters the frame path — it always runs as fast as it can.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/livenessfusionconfigurable\/livenessratehz"]}],"kind":"symbol","defaultImplementationsSections":[{"title":"LivenessFusionConfigurable Implementations","identifiers":["doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/livenessRateHz-9wbx4"],"anchor":"LivenessFusionConfigurable-Implementations"}],"hierarchy":{"paths":[["doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable"]]},"metadata":{"externalID":"s:5YEOFR26LivenessFusionConfigurableP14livenessRateHzSdSgvp","title":"livenessRateHz","role":"symbol","roleHeading":"Instance Property","modules":[{"name":"YEOFR"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"livenessRateHz"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"?"}],"symbolKind":"property","required":true},"identifier":{"url":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/livenessRateHz","interfaceLanguage":"swift"},"references":{"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/frameRateHz":{"abstract":[{"text":"The rate, in frames per second, at which the host feeds the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline. Every frame-count-tuned constant in the trust pipeline is","type":"text"},{"text":" ","type":"text"},{"text":"derived from this (see ","type":"text"},{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence","isActive":true,"type":"reference"},{"text":"), so a host that changes its","type":"text"},{"text":" ","type":"text"},{"text":"cadence keeps the same wall-clock timing instead of silently","type":"text"},{"text":" ","type":"text"},{"text":"halving or doubling every debounce.","type":"text"}],"kind":"symbol","role":"symbol","required":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz","url":"\/documentation\/yeofr\/livenessfusionconfigurable\/frameratehz","type":"topic","defaultImplementations":1,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"frameRateHz","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"title":"frameRateHz"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR":{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","abstract":[{"text":"On-device face recognition with fused liveness and TrueDepth anti-spoofing.","type":"text"}],"role":"collection","title":"YEOFR","type":"topic","kind":"symbol","url":"\/documentation\/yeofr"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/livenessRateHz":{"required":true,"kind":"symbol","abstract":[{"type":"text","text":"The rate the LIVENESS signal runs at, when it should run slower than"},{"text":" ","type":"text"},{"text":"the pipeline. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" — the default — follows ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/livenessRateHz","title":"livenessRateHz","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"k