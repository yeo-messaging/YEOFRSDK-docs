{"sections":[],"kind":"symbol","abstract":[{"text":"The rate FACE RECOGNITION runs at, when it should run slower than the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline. ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" — the default — follows ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:5YEOFR26LivenessFusionConfigurableP17recognitionRateHzSdSgvp","required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"recognitionRateHz","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"?","kind":"text"}],"title":"recognitionRateHz","role":"symbol","roleHeading":"Instance Property","modules":[{"name":"YEOFR"}],"symbolKind":"property"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"recognitionRateHz"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"? { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This sub-rates the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"grading"}]},{"type":"text","text":" half of the FR call only: align, embed"},{"text":" ","type":"text"},{"text":"and match. Vision detection still runs on every frame, because its","type":"text"},{"text":" ","type":"text"},{"text":"rects feed the framing gate, the preview overlay, the PAD crop, the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"face-exposure metering and the face-loss debounce — a face that"},{"type":"text","text":" "},{"type":"text","text":"leaves must still be noticed at full pipeline rate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As with "},{"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/livenessRateHz","isActive":true},{"text":", gating and retuning are one change: a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"frame that casts no similarity vote abstains from the latch windows"},{"type":"text","text":" "},{"type":"text","text":"entirely, and those windows are re-derived from this rate so their"},{"type":"text","text":" "},{"type":"text","text":"wall-clock spans hold. Sizing them off "},{"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz","isActive":true},{"type":"text","text":" while feeding"},{"type":"text","text":" "},{"type":"text","text":"them at a slower rate would stretch the sustain window — a departed"},{"type":"text","text":" "},{"type":"text","text":"user would keep trust longer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only ever slower. A value above "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz"},{"type":"text","text":" is clamped."}]}]}],"hierarchy":{"paths":[["doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable"]]},"defaultImplementationsSections":[{"title":"LivenessFusionConfigurable Implementations","anchor":"LivenessFusionConfigurable-Implementations","identifiers":["doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/recognitionRateHz-6v8xb"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.yeome