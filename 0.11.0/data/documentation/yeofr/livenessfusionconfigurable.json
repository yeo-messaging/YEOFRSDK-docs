t":" ","type":"text"},{"text":"pipeline. Every frame-count-tuned constant in the trust pipeline is","type":"text"},{"text":" ","type":"text"},{"text":"derived from this (see ","type":"text"},{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/FrameCadence","isActive":true,"type":"reference"},{"text":"), so a host that changes its","type":"text"},{"text":" ","type":"text"},{"text":"cadence keeps the same wall-clock timing instead of silently","type":"text"},{"text":" ","type":"text"},{"text":"halving or doubling every debounce.","type":"text"}],"kind":"symbol","role":"symbol","required":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz","url":"\/documentation\/yeofr\/livenessfusionconfigurable\/frameratehz","type":"topic","defaultImplementations":1,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"frameRateHz","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"title":"frameRateHz"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/depthTrustFlatDropFrames":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Consecutive raw-flat frames required to drop the trust gate’s"},{"type":"text","text":" "},{"type":"text","text":"confirmed-3D signal ("},{"type":"codeVoice","code":"depthTrustConfirmedThreeD"},{"type":"text","text":"). Asymmetric"},{"type":"text","text":" "},{"type":"text","text":"revoke-side stickiness for the depth signal "},{"type":"emphasis","inlineContent":[{"type":"text","text":"only"}]},{"type":"text","text":": the 3D-confirm"},{"type":"text","text":" "},{"type":"text","text":"path (5 consecutive 3D, no cold-start bypass) is untouched, so"},{"type":"text","text":" "},{"type":"text","text":"admission timing and the single-blip flash guard are unchanged —"},{"type":"text","text":" "},{"type":"text","text":"raising this only makes an already-confirmed 3D face ride out"},{"type":"text","text":" "},{"type":"text","text":"longer transient flat readings under changing light, instead of"},{"type":"text","text":" "},{"type":"text","text":"collapsing trust on a sensor blip (the depth signal AND-gates the"},{"type":"text","text":" "},{"type":"text","text":"whole fused verdict, so one flat blip drops trust even while the"},{"type":"text","text":" "},{"type":"text","text":"CNN and the recognition latch hold). The evaluator clamps this to"},{"type":"text","text":" "},{"type":"codeVoice","code":"[5, 15]"},{"type":"text","text":" — never below today’s 5, capped so a flat run still"},{"type":"text","text":" "},{"type":"text","text":"surfaces a real spoof \/ face-gone within a fraction of a second."},{"type":"text","text":" "},{"type":"text","text":"Default 5 preserves current behaviour exactly; raise it (e.g. 8 ≈"},{"type":"text","text":" "},{"type":"text","text":"400 ms at 20 fps) to smooth lighting-driven trust flicker."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthTrustFlatDropFrames","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"required":true,"title":"depthTrustFlatDropFrames","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/depthTrustFlatDropFrames","defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/depthtrustflatdropframes"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/YEOPADModel/cropScales":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cropScales","kind":"identifier"},{"text":": (narrow","kind":"text"},{"text":": ","kind":"text"},{"text":"CGFloat","kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"text":", wide","kind":"text"},{"text":": ","kind":"text"},{"text":"CGFloat","kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"How far each slot expands the face rect before a head sees it:"},{"type":"text","text":" "},{"type":"text","text":"2.7× for Quince and Papaya (one box, two patch sizes), 4.0× for Pear —"},{"type":"text","text":" "},{"type":"text","text":"each head at the scale it was trained at. Since 2026-09-04, at the"},{"type":"text","text":" "},{"type":"text","text":"model team’s request: at the 1.5×\/1.5× pair a mask grid had chosen, a"},{"type":"text","text":" "},{"type":"text","text":"hand-held tablet replay read Live from both Papaya + Pear halves on"},{"type":"text","text":" "},{"type":"text","text":"every frame, while the native scales read Replay — the bezel and hand"},{"type":"text","text":" "},{"type":"text","text":"that betray a screen sit outside a 1.5× crop. Public so a host HUD can"},{"type":"text","text":" "},{"type":"text","text":"name the crop each head reads; the effective scale a frame actually"},{"type":"text","text":" "},{"type":"text","text":"reached is reported through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/ObservedSignalRates"},{"type":"text","text":"."}],"url":"\/documentation\/yeofr\/yeopadmodel\/cropscales","type":"topic","kind":"symbol","title":"cropScales","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOPADModel\/cropScales","role":"symbol"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/padDecisionMode":{"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/paddecisionmode","kind":"symbol","abstract":[{"text":"How a stream of per-frame PAD scores becomes a verdict — continuous","type":"text"},{"text":" ","type":"text"},{"text":"authentication, or one answer per attempt. A property of the FLOW","type":"text"},{"text":" ","type":"text"},{"text":"the host runs rather than of the model; see ","type":"text"},{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOPADDecisionMode","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"padDecisionMode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"YEOPADDecisionMode","preciseIdentifier":"s:5YEOFR18YEOPADDecisionModeO"}],"required":true,"title":"padDecisionMode","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/padDecisionMode","defaultImplementations":1,"type":"topic"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/cadence":{"abstract":[{"text":"The timing constants implied by ","type":"text"},{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/frameRateHz","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/cadence","url":"\/documentation\/yeofr\/livenessfusionconfigurable\/cadence","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cadence","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"FrameCadence","preciseIdentifier":"s:5YEOFR12FrameCadenceV"}],"title":"cadence"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/evidenceMinFaceSharpness":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Minimum face-crop Laplacian variance (sharpness) for a frame to"},{"type":"text","text":" "},{"type":"text","text":"count as latch evidence. ~200 separates motion-blurred walking"},{"type":"text","text":" "},{"type":"text","text":"frames from sharp ones on the same trace (112×112 crop scale)."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"evidenceMinFaceSharpness"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"}],"required":true,"title":"evidenceMinFaceSharpness","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/evidenceMinFaceSharpness","defaultImplementations":1,"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/evidenceminfacesharpness"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/LivenessFusionConfigurable/adaptiveTemplateLearningEnabled":{"url":"\/documentation\/yeofr\/livenessfusionconfigurable\/adaptivetemplatelearningenabled","abstract":[{"type":"text","text":"Whether a trusted, recognised frame may refresh the matched"},{"text":" ","type":"text"},{"text":"identity’s adaptive templates (Slot B) — biometric reference","type":"text"},{"text":" ","type":"text"},{"text":"adaptation. ","type":"text"},{"code":"false","type":"codeVoice"},{"type":"text","text":" stops any new sample being learned; samples a"},{"text":" ","type":"text"},{"type":"text","text":"gallery already holds (learned earlier, or carried in a loaded"},{"type":"text","text":" "},{"type":"text","text":"tracker) keep matching until the identity is re-enrolled. FIDO"},{"type":"text","text":" "},{"type":"text","text":"Biometrics Requirements §5.1.6 require adaptation to be off while a"},{"type":"text","text":" "},{"text":"laboratory tests the system.","type":"text"}],"title":"adaptiveTemplateLearningEnabled","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"adaptiveTemplateLearningEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"defaultImplementations":1,"kind":"symbol","required":true,"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable\/adaptiveTemplateLearningEnabled"},"doc://com.yeomessaging.YEOFR/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier