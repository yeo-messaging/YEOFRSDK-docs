{"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Update the fusion toggles. The session stores its own copy to"},{"type":"text","text":" "},{"type":"text","text":"physically gate the non-recognition work in "},{"type":"codeVoice","code":"processFrame"},{"type":"text","text":" (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"fusionConfig"},{"type":"text","text":"); the evaluator’s copy governs "},{"type":"codeVoice","code":"evaluateFusedTrust"},{"type":"text","text":"."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"name":"YEOFR"}],"externalID":"s:5YEOFR16FaceTrustSessionC15setFusionConfigyyxYaAA08LivenessF12ConfigurableRzlF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setFusionConfig","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LivenessFusionConfigurable","kind":"typeIdentifier","preciseIdentifier":"s:5YEOFR26LivenessFusionConfigurableP"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"setFusionConfig(_:)","symbolKind":"method"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setFusionConfig","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"newConfig","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LivenessFusionConfigurable","kind":"typeIdentifier","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/LivenessFusionConfigurable","preciseIdentifier":"s:5YEOFR26LivenessFusionConfigurableP"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","