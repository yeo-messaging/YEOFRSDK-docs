{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oneShot","kind":"identifier"},{"text":"(","kind":"text"},{"text":"samples","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"bar","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Float","kind":"typeIdentifier","preciseIdentifier":"s:Sf"},{"text":")","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"code":"samples","type":"codeVoice"},{"text":" is the count of SCORED frames, not of frames seen: a frame","type":"text"},{"text":" ","type":"text"},{"text":"with no confident face lengthens the attempt rather than deciding it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"bar","type":"codeVoice"},{"text":" is this mode’s OWN operating point, deliberately not the","type":"text"},{"text":" ","type":"text"},{"text":"continuous rule’s: one shot has no revoke, so a bar fitted for a","type":"text"},{"text":" ","type":"text"},{"text":"machine that can revoke would be inherited from dynamics that no","type":"text"},{"text":" ","type":"text"},{"text":"longer exist. A wrong admit here is final for the attempt while a","type":"text"},{"text":" ","type":"text"},{"text":"wrong reject only costs a retry, so this bar has a case for being","type":"text"},{"text":" ","type":"text"},{"text":"STRICTER than the continuous one, not looser.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"One verdict per attempt: bank ","type":"text"},{"type":"codeVoice","code":"samples"},{"text":" fresh scores, average them,","type":"text"},{"text":" ","type":"text"},{"text":"decide once against ","type":"text"},{"type":"codeVoice","code":"bar"},{"text":", and hold that answer until the face state","type":"text"},{"text":" ","type":"text"},{"text":"is reset. What a verification GATE needs — the user sees","type":"text"},{"text":" ","type":"text"},{"text":"“verifying”, then one accept or reject, and does not get a different","type":"text"},{"text":" ","type":"text"},{"text":"answer for looking at a different moment.","type":"text"}],"variants":[{"paths":["\/documentation\/yeofr\/yeopaddecisionmode\/oneshot(samples:bar:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"case","role":"symbol","roleHeading":"Case","modules":[{"name":"YEOFR"}],"externalID":"s:5YEOFR18YEOPADDecisionModeO7oneShotyACSi_SftcACmF","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oneShot","kind":"identifier"},{"text":"(","kind":"text"},{"text":"samples","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bar","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sf","kind":"typeIdentifier","text":"Float"},{"kind":"text","text":")"}],"title":"YEOPADDecisionMode.oneShot(samples:bar:)"},"hierarchy":{"paths":[["doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR","doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOPADDecisionMode"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOPADDecisionMode\/oneShot(samples:bar:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://com.yeomessaging.YEOFR/documentation/YEOFR/YEOPADDecisionMode":{"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"YEOPADDecisionMode"}],"abstract":[{"type":"text","text":"How a stream of per-frame PAD scores becomes a verdict."}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"YEOPADDecisionMode"}],"title":"YEOPA