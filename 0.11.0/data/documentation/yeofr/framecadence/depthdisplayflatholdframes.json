{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthDisplayFlatHoldFrames","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"The literal this replaces is 15 frames, and its comment described","type":"text"},{"text":" ","type":"text"},{"text":"that as “~0.75 s at 20 fps” — written before the pipeline moved to","type":"text"},{"text":" ","type":"text"},{"text":"10 Hz and never restated, so the shipped hold has in fact been","type":"text"},{"text":" ","type":"text"},{"text":"1.5 s. This derives the duration the code actually has today, not","type":"text"},{"text":" ","type":"text"},{"text":"the one its comment claimed: correcting the number here would be a","type":"text"},{"text":" ","type":"text"},{"text":"silent behaviour change smuggled in as a refactor. If 0.75 s was the","type":"text"},{"text":" ","type":"text"},{"text":"intent, that is a separate, deliberate retune with its own evidence.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"How long the displayed depth chip holds “3D” across a flat run."},{"type":"text","text":" "},{"type":"text","text":"15 @ 10 Hz."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yeofr\/framecadence\/depthdisplayflatholdframes"]}],"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthDisplayFlatHoldFrames","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"roleHeading":"Instance Property","externalID":"s:5YEOFR12FrameCadenceV