ell as on every frame."}]},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/YEOFRSDK/enroll(faceID:name:)":{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/YEOFRSDK\/enroll(faceID:name:)","abstract":[{"type":"text","text":"Single-shot enroll of the face in the current frame."}],"role":"symbol","title":"enroll(faceID:name:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enroll","kind":"identifier"},{"text":"(","kind":"text"},{"text":"faceID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int64","preciseIdentifier":"s:s5Int64V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"kind":"text","text":": "},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5YEOFR15FRSDKReturnCodeO","text":"FRSDKReturnCode"}],"type":"topic","url":"\/documentation\/yeofr\/yeofrsdk\/enroll(faceid:name:)","kind":"symbol"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/PoseWalkEnrollment/Step":{"role":"symbol","title":"PoseWalkEnrollment.Step","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Step","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/yeofr\/posewalkenrollment\/step","type":"topic","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PoseWalkEnrollment\/Step","abstract":[{"type":"text","text":"The outcome of one "},{"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PoseWalkEnrollment\/advance(_:bank:)","isActive":true},{"type":"text","text":" call."}],"navigatorTitle":[{"text":"Step","kind":"identifier"}]},"doc://com.yeomessaging.YEOFR/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/com.yeomessaging.YEOFR\/s8SendableP","title":"Swift.Sendable"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/PoseWalkEnrollment/samplesBanked":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"samplesBanked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[{"type":"text","text":"Samples the engine answered "},{"type":"codeVoice","code":".OK"},{"type":"text","text":" for: the arming sample, then every"},{"type":"text","text":" "},{"type":"text","text":"pose, between-pose and top-up sample taken through "},{"type":"codeVoice","code":"bank"},{"type":"text","text":". This is"},{"type":"text","text":" "},{"type":"text","text":"what the foundation slot holds; it never passes "},{"type":"reference","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PoseWalkEnrollment\/requiredSamples","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/yeofr\/posewalkenrollment\/samplesbanked","type":"topic","kind":"symbol","title":"samplesBanked","identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PoseWalkEnrollment\/samplesBanked","role":"symbol"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/PoseWalkEnrollment/Step/completed":{"identifier":"doc:\/\/com.yeomessaging.YEOFR\/documentation\/YEOFR\/PoseWalkEnrollment\/Step\/completed","abstract":[{"type":"text","text":"The bank is full. Persist the tracker; an empty one is a failure to"},{"type":"text","text":" "},{"type":"text","text":"enrol."}],"role":"symbol","title":"PoseWalkEnrollment.Step.completed","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"completed","kind":"identifier"}],"type":"topic","url":"\/documentation\/yeofr\/posewalkenrollment\/step\/completed","kind":"symbol"},"doc://com.yeomessaging.YEOFR/documentation/YEOFR/PoseWalkEnrollment/currentTarget":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"currentTarget"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:5YEOFR18PoseWalkEnrollmentV0B0O","text":"Pose"},{"kind":"text","text":